  <button aria-label=\"Rời phòng\" class=\"ml-2 flex h-11 min-w-[142px] items-center justify-center gap-2 rounded-md bg-[#DA373C] px-4 text-[13px] font-bold text-white hover:bg-[#C83237]\" data-kid=\"1-3-2-3-4\" data-name=\"leave room button\">\n                    <i class=\"ph ph-phone-disconnect text-[18px]\" data-kid=\"1-3-2-3-4-1\" data-name=\"phone-disconnect icon\">\n                    </i>\n                    <span data-kid=\"1-3-2-3-4-2\" data-name=\"leave room button label\">\n                        Rời phòng\n                    </span>\n                </button>\n            </div>\n            <div class=\"mt-1.5 text-center text-[11px] text-[#94969C]\" data-kid=\"1-3-2-4\" data-name=\"controls disabled notice\">\n                Điều khiển mic, camera và chia sẻ màn hình chưa khả dụng trong bản xem trước.\n            </div>\n        </section>\n        <!-- Source chooser overlay: choices are illustrative only; no media stream is claimed -->\n        <div class=\"absolute inset-0 z-40 flex items-center justify-center bg-[#090A0C]/70 p-8\" data-kid=\"1-3-3\" data-name=\"screen share dialog overlay\" role=\"presentation\">\n            <section aria-labelledby=\"source-dialog-title\" aria-modal=\"true\" class=\"w-[590px] overflow-hidden rounded-[10px] bg-[#2B2D31] shadow-[0_16px_48px_rgba(0,0,0,0.48)] ring-1 ring-[#17181B]\" data-kid=\"1-3-3-1\" data-name=\"screen share source dialog\" role=\"dialog\">\n                <div class=\"flex items-start justify-between border-b border-[#3A3C42] px-5 py-4\" data-kid=\"1-3-3-1-1\" data-name=\"dialog header\">\n                    <div data-kid=\"1-3-3-1-1-1\" data-name=\"dialog title block\">\n                        <h2 class=\"text-[17px] font-bold\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"dialog title\" id=\"source-dialog-title\">\n                            Chọn nguồn chia sẻ màn hình\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#B9BAC0]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"dialog subtitle\">\n                            Bản xem trước · media adapter chưa kết nối\n                        </p>\n                    </div>\n                    <button aria-label=\"Đóng\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#B9BAC0] hover:bg-[#3A3C42]\" data-kid=\"1-3-3-1-1-2\" data-name=\"close dialog button\">\n                        <i class=\"ph ph-x text-[18px]\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"close X icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"px-5 pt-4\" data-kid=\"1-3-3-1-2\" data-name=\"dialog body\">\n                    <div class=\"flex gap-5 border-b border-[#42444A] text-[13px] font-semibold\" data-kid=\"1-3-3-1-2-1\" data-name=\"dialog tab bar\">\n                        <button class=\"border-b-2 border-[#5865F2] px-1 pb-2.5 text-white\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"fullscreen tab\">\n                            Toàn màn hình\n                        </button>\n                        <button class=\"px-1 pb-2.5 text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"window tab\">\n                            Cửa sổ\n                        </button>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-[1fr_218px] gap-4\" data-kid=\"1-3-3-1-2-2\" data-name=\"dialog two-column content\">\n                        <div data-kid=\"1-3-3-1-2-2-1\" data-name=\"source options list column\">\n                            <div class=\"mb-2 text-[11px] font-bold tracking-wide text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"source options header\">\n                                NGUỒN CÓ THỂ CHỌN\n                            </div>\n                            <button class=\"flex w-full items-center gap-3 rounded-md bg-[#3B3D44] px-3 py-3 text-left ring-1 ring-[#5865F2]\" data-kid=\"1-3-3-1-2-2-1-2\" data-name=\"selected source card (Màn hình 1)\">\n                                <span class=\"flex h-9 w-9 items-center justify-center rounded bg-[#292A2F] text-[#D7D8DC]\" data-kid=\"1-3-3-1-2-2-1-2-1\" data-name=\"source icon container\">\n                                    <i class=\"ph ph-desktop-tower text-[20px]\" data-kid=\"1-3-3-1-2-2-1-2-1-1\" data-name=\"desktop tower icon\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-3-3-1-2-2-1-2-2\" data-name=\"source details\">\n                                    <span class=\"block truncate text-[13px] font-semibold\" data-kid=\"1-3-3-1-2-2-1-2-2-1\" data-name=\"source name\">\n                                        Màn hình 1\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-2-1-2-2-2\" data-name=\"source subtitle\">\n                                        Nguồn mẫu · không truy cập thiết bị\n                                    </span>\n                                </span>\n                                <span class=\"flex h-[18px] w-[18px] items-center justify-center rounded-full border-2 border-[#7C85FF]\" data-kid=\"1-3-3-1-2-2-1-2-3\" data-name=\"selected radio indicator\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#7C85FF]\" data-kid=\"1-3-3-1-2-2-1-2-3-1\" data-name=\"radio dot\">\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"mt-2 flex w-full items-center gap-3 rounded-md px-3 py-3 text-left hover:bg-[#34363B]\" data-kid=\"1-3-3-1-2-2-1-3\" data-name=\"alternate source card (Màn hình mở rộng)\">\n                                <span class=\"flex h-9 w-9 items-center justify-center rounded bg-[#292A2F] text-[#B9BAC0]\" data-kid=\"1-3-3-1-2-2-1-3-1\" data-name=\"source icon container\">\n                                    <i class=\"ph ph-monitor text-[20px]\" data-kid=\"1-3-3-1-2-2-1-3-1-1\" data-name=\"monitor icon\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-3-3-1-2-2-1-3-2\" data-name=\"source details\">\n                                    <span class=\"block truncate text-[13px] font-semibold text-[#D7D8DC]\" data-kid=\"1-3-3-1-2-2-1-3-2-1\" data-name=\"source name\">\n                                        Màn hình mở rộng\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#94969C]\" data-kid=\"1-3-3-1-2-2-1-3-2-2\" data-name=\"source subtitle\">\n                                        Nguồn mẫu · chưa khả dụng\n                                    </span>\n                                </span>\n                                <span class=\"h-[18px] w-[18px] rounded-full border border-[#777980]\" data-kid=\"1-3-3-1-2-2-1-3-3\" data-name=\"unselected radio circle\">\n                                </span>\n                            </button>\n                            <button class=\"mt-1.5 flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left hover:bg-[#34363B]\" data-kid=\"1-3-3-1-2-2-1-4\" data-name=\"sample application window source (unavailable)\">\n                                <span class=\"flex h-8 w-9 items-center justify-center rounded bg-[#292A2F] text-[#B9BAC0]\" data-kid=\"1-3-3-1-2-2-1-4-1\" data-name=\"window icon container\">\n                                    <i class=\"ph ph-app-window text-[19px]\" data-kid=\"1-3-3-1-2-2-1-4-1-1\" data-name=\"application window icon\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-3-3-1-2-2-1-4-2\" data-name=\"window source details\">\n                                    <span class=\"block truncate text-[13px] font-semibold text-[#D7D8DC]\" data-kid=\"1-3-3-1-2-2-1-4-2-1\" data-name=\"window source name\">\n                                        Cửa sổ ứng dụng\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#94969C]\" data-kid=\"1-3-3-1-2-2-1-4-2-2\" data-name=\"window source status\">\n                                        Nguồn mẫu · chưa khả dụng\n                                    </span>\n                                </span>\n                                <span class=\"h-[18px] w-[18px] rounded-full border border-[#777980]\" data-kid=\"1-3-3-1-2-2-1-4-3\" data-name=\"unselected window source radio\">\n                                </span>\n                            </button>\n                        </div>\n                        <div data-kid=\"1-3-3-1-2-2-2\" data-name=\"preview column\">\n                            <div class=\"mb-2 text-[11px] font-bold tracking-wide text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"preview header\">\n                                XEM TRƯỚC\n                            </div>\n                            <div class=\"flex h-[126px] flex-col items-center justify-center rounded-md bg-[#1D1E22] text-center ring-1 ring-[#3A3C42]\" data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"preview placeholder box\">\n                                <i class=\"ph ph-monitor text-[27px] text-[#777980]\" data-kid=\"1-3-3-1-2-2-2-2-1\" data-name=\"monitor icon\">\n                                </i>\n                                <span class=\"mt-2 text-[12px] font-semibold text-[#C5C6CB]\" data-kid=\"1-3-3-1-2-2-2-2-2\" data-name=\"preview unavailable text\">\n                                    Xem trước chưa khả dụng\n                                </span>\n                                <span class=\"mt-1 px-2 text-[10px] leading-4 text-[#94969C]\" data-kid=\"1-3-3-1-2-2-2-2-3\" data-name=\"preview UI-only note\">\n                                    Nguồn chỉ là lựa chọn giao diện\n                                </span>\n                            </div>\n                            <label class=\"mt-3 flex items-center gap-2 text-[11px] text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-2-2-3\" data-name=\"show preview checkbox label\">\n                                <input checked=\"\" class=\"h-3.5 w-3.5 accent-[#5865F2]\" data-kid=\"1-3-3-1-2-2-2-3-1\" data-name=\"show preview checkbox input\" type=\"checkbox\"/>\n                                Hiện xem trước (nếu được hỗ trợ)\n                            </label>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-2 rounded-md bg-[#242529] px-3 py-2.5 text-[11px] leading-4 text-[#AFB1B6]\" data-kid=\"1-3-3-1-2-3\" data-name=\"dialog info banner\">\n                        <i class=\"ph ph-info mt-0.5 shrink-0 text-[15px]\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"info icon\">\n                        </i>\n                        <span data-kid=\"1-3-3-1-2-3-2\" data-name=\"info banner text\">\n                            Chọn nguồn chỉ lưu lựa chọn trong bản xem trước; chưa bắt đầu chia sẻ màn hình. Media adapter chưa kết nối.\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex items-center justify-between border-t border-[#3A3C42] px-5 py-4\" data-kid=\"1-3-3-1-3\" data-name=\"dialog footer\">\n                    <span class=\"text-[11px] text-[#94969C]\" data-kid=\"1-3-3-1-3-1\" data-name=\"dialog footer note\">\n                        Không có hình ảnh màn hình đang truyền.\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-1-3-2\" data-name=\"dialog action buttons\">\n                        <button class=\"h-9 rounded-md px-4 text-[13px] font-semibold text-[#E2E3E6] hover:bg-[#3A3C42]\" data-kid=\"1-3-3-1-3-2-1\" data-name=\"cancel button\">\n                            Hủy\n                        </button>\n                        <button class=\"h-9 rounded-md bg-[#5865F2] px-4 text-[13px] font-bold text-white hover:bg-[#4752C4]\" data-kid=\"1-3-3-1-3-2-2\" data-name=\"select source preview button\">\n                            Chọn nguồn (chỉ xem trước)\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n",
