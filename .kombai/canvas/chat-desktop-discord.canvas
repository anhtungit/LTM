        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"flex h-[900px] min-h-[900px] w-full overflow-hidden bg-[var(--rail)] font-[var(--font-ui)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"messaging app layout container\" style=\"--rail:#151619;--sidebar:#1E1F23;--main:#27292D;--composer:#313338;--selected:#3B3D44;--text-primary:#EAEBEE;--text-secondary:#AFB1B6;--muted:#777A83;--accent:#5E68F7;--font-ui:'Nunito Sans',system-ui,sans-serif\">\n    <aside class=\"flex h-full w-[72px] shrink-0 flex-col items-center bg-[var(--rail)] py-3\" data-kid=\"1-1\" data-name=\"server rail sidebar\">\n        <button aria-label=\"Mở tin nhắn\" class=\"flex h-12 w-12 items-center justify-center rounded-[18px] bg-[var(--accent)] text-[24px] text-white\" data-kid=\"1-1-1\" data-name=\"open messages button with chat icon\">\n            <i class=\"ph ph-chat-circle-dots\" data-kid=\"1-1-1-1\" data-name=\"chat bubble with dots icon\">\n            </i>\n        </button>\n        <div class=\"my-3 h-px w-8 bg-white/10\" data-kid=\"1-1-2\" data-name=\"rail vertical divider\">\n        </div>\n        <div class=\"flex flex-col items-center gap-2.5\" data-kid=\"1-1-3\" data-name=\"server list container\">\n            <button aria-label=\"Nhà mình\" class=\"relative flex h-12 w-12 items-center justify-center rounded-[18px] bg-[var(--accent)] text-[15px] font-extrabold text-white\" data-kid=\"1-1-3-1\" data-name=\"active home server avatar with selection tab\">\n                NH\n                <span class=\"absolute -left-[12px] top-2 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-3-1-1\" data-name=\"server selection tab indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Nhóm thiết kế\" class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#45485B] text-[14px] font-bold text-[#D8DAF4]\" data-kid=\"1-1-3-2\" data-name=\"design team server avatar\">\n                D\n            </button>\n            <button aria-label=\"Nhóm học tập\" class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#38514A] text-[14px] font-bold text-[#D0E6DA]\" data-kid=\"1-1-3-3\" data-name=\"study group server avatar\">\n                L\n            </button>\n            <button aria-label=\"Thêm nhóm\" class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#232428] text-[22px] text-[#43C07A]\" data-kid=\"1-1-3-4\" data-name=\"add server button\">\n                <i class=\"ph ph-plus\" data-kid=\"1-1-3-4-1\" data-name=\"plus icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"mt-auto flex flex-col items-center gap-3\" data-kid=\"1-1-4\" data-name=\"rail bottom actions container\">\n            <button aria-label=\"Tải xuống\" class=\"flex h-10 w-10 items-center justify-center rounded-full text-[20px] text-[var(--text-secondary)]\" data-kid=\"1-1-4-1\" data-name=\"download button with download icon\">\n                <i class=\"ph ph-download-simple\" data-kid=\"1-1-4-1-1\" data-name=\"download arrow icon\">\n                </i>\n            </button>\n            <div class=\"relative flex h-9 w-9 items-center justify-center rounded-full bg-[#B68C72] text-[13px] font-bold text-[#241A16]\" data-kid=\"1-1-4-2\" data-name=\"user avatar with online status dot\">\n                A\n                <span class=\"absolute bottom-0 right-0 h-[11px] w-[11px] rounded-full border-[2px] border-[var(--rail)] bg-[#43C07A]\" data-kid=\"1-1-4-2-1\" data-name=\"online status indicator dot\">\n                </span>\n            </div>\n        </div>\n    </aside>\n    <aside class=\"flex h-full w-[240px] shrink-0 flex-col bg-[var(--sidebar)]\" data-kid=\"1-2\" data-name=\"channels sidebar\">\n        <button class=\"flex h-12 shrink-0 items-center justify-between border-b border-black/20 px-4 text-left text-[15px] font-extrabold text-[var(--text-primary)]\" data-kid=\"1-2-1\" data-name=\"server name header with dropdown caret\">\n            <span data-kid=\"1-2-1-1\" data-name=\"current server name text\">\n                Nhà mình\n            </span>\n            <i class=\"ph ph-caret-down text-[15px] text-[var(--text-secondary)]\" data-kid=\"1-2-1-2\" data-name=\"dropdown caret icon\">\n            </i>\n        </button>\n        <div class=\"flex items-center gap-2 px-3 pb-2 pt-4\" data-kid=\"1-2-2\" data-name=\"sidebar search row\">\n            <button class=\"flex h-8 flex-1 items-center gap-2 rounded-[5px] bg-[#16171A] px-2.5 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-2-1\" data-name=\"search button with magnifier\">\n                <i class=\"ph ph-magnifying-glass text-[15px]\" data-kid=\"1-2-2-1-1\" data-name=\"magnifying glass icon\">\n                </i>\n                Tìm kiếm\n            </button>\n            <button aria-label=\"Hộp thư\" class=\"flex h-8 w-8 items-center justify-center rounded-[5px] text-[18px] text-[var(--text-secondary)]\" data-kid=\"1-2-2-2\" data-name=\"inbox tray button\">\n                <i class=\"ph ph-tray\" data-kid=\"1-2-2-2-1\" data-name=\"tray inbox icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"flex min-h-0 flex-1 flex-col overflow-y-auto px-2 pb-3 pt-1\" data-kid=\"1-2-3\" data-name=\"channel list scroll area\">\n            <div class=\"mb-1 mt-2 px-2 text-[11px] font-extrabold tracking-[0.06em] text-[#8F929A]\" data-kid=\"1-2-3-1\" data-name=\"text channels section label\">\n                KÊNH TRÒ CHUYỆN\n            </div>\n            <button class=\"flex h-9 items-center gap-2 rounded-[5px] px-2 text-[14px] text-[#AFB1B6]\" data-kid=\"1-2-3-2\" data-name=\"text channel item for chung\">\n                <span class=\"text-[20px] text-[#777A83]\" data-kid=\"1-2-3-2-1\" data-name=\"hash symbol for text channel\">\n                    #\n                </span>\n                chung\n            </button>\n            <button class=\"flex h-9 items-center gap-2 rounded-[5px] px-2 text-[14px] text-[#AFB1B6]\" data-kid=\"1-2-3-3\" data-name=\"text channel item for files\">\n                <span class=\"text-[20px] text-[#777A83]\" data-kid=\"1-2-3-3-1\" data-name=\"hash symbol for text channel\">\n                    #\n                </span>\n                ảnh-và-file\n            </button>\n            <div class=\"mb-1 mt-5 flex items-center justify-between px-2 text-[11px] font-extrabold tracking-[0.06em] text-[#8F929A]\" data-kid=\"1-2-3-4\" data-name=\"voice channels section header with add\">\n                <span data-kid=\"1-2-3-4-1\" data-name=\"voice channels label text\">\n                    KÊNH GẶP\n                </span>\n                <i class=\"ph ph-plus text-[15px]\" data-kid=\"1-2-3-4-2\" data-name=\"plus icon for adding voice channel\">\n                </i>\n            </div>\n            <button class=\"flex h-9 items-center gap-2 rounded-[5px] px-2 text-[14px] text-[#AFB1B6]\" data-kid=\"1-2-3-5\" data-name=\"voice channel item with speaker icon\">\n                <i class=\"ph ph-speaker-high text-[18px] text-[#777A83]\" data-kid=\"1-2-3-5-1\" data-name=\"speaker volume icon\">\n                </i>\n                Phòng chung\n            </button>\n            <div class=\"mb-1 mt-5 px-2 text-[11px] font-extrabold tracking-[0.06em] text-[#8F929A]\" data-kid=\"1-2-3-6\" data-name=\"community section label\">\n                CÙNG NHAU\n            </div>\n            <button class=\"flex h-9 items-center gap-2 rounded-[5px] bg-[var(--selected)] px-2 text-[14px] font-semibold text-white\" data-kid=\"1-2-3-7\" data-name=\"selected game channel item\">\n                <i class=\"ph ph-game-controller text-[18px] text-[var(--text-secondary)]\" data-kid=\"1-2-3-7-1\" data-name=\"game controller icon\">\n                </i>\n                Trò chơi\n            </button>\n            <p class=\"ml-8 mt-1 text-[12px] leading-4 text-[#777A83]\" data-kid=\"1-2-3-8\" data-name=\"coming soon note text\">\n                Sẽ có thêm sau\n            </p>\n        </div>\n        <div class=\"flex h-[64px] shrink-0 items-center gap-2.5 bg-[#18191C] px-3\" data-kid=\"1-2-4\" data-name=\"sidebar user footer bar\">\n            <div class=\"relative flex h-8 w-8 items-center justify-center rounded-full bg-[#B68C72] text-[12px] font-bold text-[#241A16]\" data-kid=\"1-2-4-1\" data-name=\"user avatar with online status dot\">\n                A\n                <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-[2px] border-[#18191C] bg-[#43C07A]\" data-kid=\"1-2-4-1-1\" data-name=\"online status indicator dot\">\n                </span>\n            </div>\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2\" data-name=\"user identity text block\">\n                <div class=\"truncate text-[13px] font-bold leading-4 text-white\" data-kid=\"1-2-4-2-1\" data-name=\"username text\">\n                    an.nguyen\n                </div>\n                <div class=\"text-[11px] leading-4 text-[#A1A3AA]\" data-kid=\"1-2-4-2-2\" data-name=\"user online status text\">\n                    Trực tuyến\n                </div>\n            </div>\n            <button aria-label=\"Cài đặt người dùng\" class=\"flex h-8 w-8 items-center justify-center rounded-[5px] text-[18px] text-[#B3B5BC]\" data-kid=\"1-2-4-3\" data-name=\"user settings gear button\">\n                <i class=\"ph ph-gear-six\" data-kid=\"1-2-4-3-1\" data-name=\"gear settings icon\">\n                </i>\n            </button>\n        </div>\n    </aside>\n    <main class=\"flex min-w-0 flex-1 flex-col bg-[var(--main)]\" data-kid=\"1-3\" data-name=\"main content panel\">\n        <header class=\"flex h-12 shrink-0 items-center justify-between border-b border-black/15 px-4 shadow-[0_1px_0_rgba(255,255,255,0.015)]\" data-kid=\"1-3-1\" data-name=\"channel header bar\">\n            <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-3-1-1\" data-name=\"channel title group\">\n                <i class=\"ph ph-game-controller text-[20px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-1-1\" data-name=\"game controller icon\">\n                </i>\n                <span class=\"text-[15px] font-bold text-white\" data-kid=\"1-3-1-1-2\" data-name=\"channel name text\">\n                    Trò chơi\n                </span>\n                <span class=\"mx-1 h-5 w-px bg-white/10\" data-kid=\"1-3-1-1-3\" data-name=\"header vertical divider\">\n                </span>\n                <span class=\"truncate text-[13px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-1-4\" data-name=\"channel topic description\">\n                    Những trò chơi để chơi cùng nhau\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 text-[19px] text-[#A9ABB2]\" data-kid=\"1-3-1-2\" data-name=\"header action icon group\">\n                <button aria-label=\"Thông báo\" class=\"flex h-8 w-8 items-center justify-center rounded-[5px]\" data-kid=\"1-3-1-2-1\" data-name=\"notifications bell button\">\n                    <i class=\"ph ph-bell\" data-kid=\"1-3-1-2-1-1\" data-name=\"bell icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Thành viên\" class=\"flex h-8 w-8 items-center justify-center rounded-[5px]\" data-kid=\"1-3-1-2-2\" data-name=\"members list button\">\n                    <i class=\"ph ph-users-three\" data-kid=\"1-3-1-2-2-1\" data-name=\"three users icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <section class=\"flex min-h-0 flex-1 items-center justify-center px-10\" data-kid=\"1-3-2\" data-name=\"games empty state section\">\n            <div class=\"-mt-8 flex w-full max-w-[460px] flex-col items-center text-center\" data-kid=\"1-3-2-1\" data-name=\"empty state content block\">\n                <div class=\"mb-7 flex h-[112px] w-[160px] items-center justify-center\" data-kid=\"1-3-2-1-1\" data-name=\"game controller illustration container\">\n                    <div class=\"relative h-[64px] w-[126px] rounded-[28px] bg-[#3A3C43]\" data-kid=\"1-3-2-1-1-1\" data-name=\"game controller illustration body\">\n                        <div class=\"absolute left-[24px] top-[20px] h-[24px] w-[24px]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"dpad cross on controller\">\n                            <span class=\"absolute left-[9px] top-0 h-[24px] w-[7px] rounded-[2px] bg-[#878A95]\" data-kid=\"1-3-2-1-1-1-1-1\" data-name=\"dpad vertical bar\">\n                            </span>\n                            <span class=\"absolute left-0 top-[9px] h-[7px] w-[24px] rounded-[2px] bg-[#878A95]\" data-kid=\"1-3-2-1-1-1-1-2\" data-name=\"dpad horizontal bar\">\n                            </span>\n                        </div>\n                        <span class=\"absolute right-[27px] top-[17px] h-[11px] w-[11px] rounded-full bg-[#5E68F7]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"accent controller button\">\n                        </span>\n                        <span class=\"absolute right-[13px] top-[29px] h-[11px] w-[11px] rounded-full bg-[#AFB1B6]\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"neutral controller button\">\n                        </span>\n                        <span class=\"absolute right-[41px] top-[29px] h-[11px] w-[11px] rounded-full bg-[#AFB1B6]\" data-kid=\"1-3-2-1-1-1-4\" data-name=\"neutral controller button\">\n                        </span>\n                        <span class=\"absolute right-[27px] top-[41px] h-[11px] w-[11px] rounded-full bg-[#AFB1B6]\" data-kid=\"1-3-2-1-1-1-5\" data-name=\"neutral controller button\">\n                        </span>\n                        <span class=\"absolute -bottom-[9px] left-[19px] h-[21px] w-[15px] rotate-[18deg] rounded-b-[8px] bg-[#3A3C43]\" data-kid=\"1-3-2-1-1-1-6\" data-name=\"left controller leg\">\n                        </span>\n                        <span class=\"absolute -bottom-[9px] right-[19px] h-[21px] w-[15px] -rotate-[18deg] rounded-b-[8px] bg-[#3A3C43]\" data-kid=\"1-3-2-1-1-1-7\" data-name=\"right controller leg\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mb-2 inline-flex items-center gap-2 rounded-[5px] bg-[#34363D] px-2.5 py-1 text-[12px] font-bold text-[#C7C9D1]\" data-kid=\"1-3-2-1-2\" data-name=\"not-integrated status badge\">\n                    <span class=\"h-[7px] w-[7px] rounded-full bg-[#8E9098]\" data-kid=\"1-3-2-1-2-1\" data-name=\"status dot inside badge\">\n                    </span>\n                    Chưa tích hợp\n                </div>\n                <h1 class=\"mb-2 text-[23px] font-extrabold leading-8 text-[var(--text-primary)]\" data-kid=\"1-3-2-1-3\" data-name=\"empty state headline\">\n                    Trò chơi sẽ có ở đây\n                </h1>\n                <p class=\"max-w-[390px] text-[14px] leading-[22px] text-[var(--text-secondary)]\" data-kid=\"1-3-2-1-4\" data-name=\"empty state description text\">\n                    Khu vực này sẽ dành cho những trò chơi mọi người có thể cùng tham gia khi tính năng được kết nối.\n                </p>\n            </div>\n        </section>\n        <footer class=\"flex h-[52px] shrink-0 items-center gap-2 border-t border-black/15 px-4 text-[12px] text-[#888B93]\" data-kid=\"1-3-3\" data-name=\"main footer status strip\">\n            <i class=\"ph ph-info text-[15px]\" data-kid=\"1-3-3-1\" data-name=\"information icon in footer\">\n            </i>\n            Khu vực trò chơi chưa được kết nối với hệ thống.\n        </footer>\n    </main>\n</div>\n",
