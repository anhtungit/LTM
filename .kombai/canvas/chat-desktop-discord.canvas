      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"relative h-[900px] w-full overflow-hidden bg-[#27292d] font-['Nunito_Sans',sans-serif] text-[#eaebee]\" data-kid=\"1\" data-name=\"app root container\">\n    <div class=\"flex h-full w-full\" data-kid=\"1-1\" data-name=\"three-pane chat layout\">\n        <aside aria-label=\"Thanh cộng đồng\" class=\"flex w-[72px] shrink-0 flex-col items-center gap-2 bg-[#151619] px-3 py-4\" data-kid=\"1-1-1\" data-name=\"community rail navigation\">\n            <button aria-label=\"Tin nhắn\" class=\"relative flex h-12 w-12 items-center justify-center rounded-2xl bg-[#5e68f7] text-[22px] text-white\" data-kid=\"1-1-1-1\" data-name=\"active community messages button\">\n                <i class=\"ph ph-chat-circle-dots\" data-kid=\"1-1-1-1-1\" data-name=\"chat conversation icon\">\n                </i>\n                <span class=\"absolute -left-3 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-1-1-2\" data-name=\"active tab indicator bar\">\n                </span>\n            </button>\n            <div class=\"my-1 h-px w-8 bg-[#34363b]\" data-kid=\"1-1-1-2\" data-name=\"community rail divider line\">\n            </div>\n            <button aria-label=\"Cộng đồng Thiết kế\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#313338] text-[21px] font-extrabold text-[#e1e2e5]\" data-kid=\"1-1-1-3\" data-name=\"design community shortcut button\">\n                D\n            </button>\n            <button aria-label=\"Cộng đồng Lập trình\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#313338] text-[21px] font-extrabold text-[#e1e2e5]\" data-kid=\"1-1-1-4\" data-name=\"programming community shortcut button\">\n                L\n            </button>\n            <button aria-label=\"Thêm cộng đồng\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#313338] text-[#43c07a]\" data-kid=\"1-1-1-5\" data-name=\"add community button\">\n                <i class=\"ph ph-plus text-[23px]\" data-kid=\"1-1-1-5-1\" data-name=\"plus add icon\">\n                </i>\n            </button>\n            <div aria-label=\"Tài khoản Lê An\" class=\"mt-auto flex h-11 w-11 items-center justify-center rounded-full bg-[#b987d5] text-sm font-bold text-[#201b24]\" data-kid=\"1-1-1-6\" data-name=\"current user account avatar\">\n                LA\n            </div>\n        </aside>\n        <aside aria-label=\"Danh sách tin nhắn\" class=\"flex w-[250px] shrink-0 flex-col bg-[#1e1f23]\" data-kid=\"1-1-2\" data-name=\"conversation list panel\">\n            <div class=\"flex h-14 items-center justify-between border-b border-[#17181b] px-4\" data-kid=\"1-1-2-1\" data-name=\"conversation list header bar\">\n                <span class=\"text-[15px] font-bold tracking-[0.01em]\" data-kid=\"1-1-2-1-1\" data-name=\"conversation list title\">\n                    Tin nhắn\n                </span>\n                <button aria-label=\"Tạo tin nhắn\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#afb1b6] hover:bg-[#34363b]\" data-kid=\"1-1-2-1-2\" data-name=\"new message button\">\n                    <i class=\"ph ph-note-pencil text-[19px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"edit note icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"mx-3 mt-4 flex h-9 items-center gap-2 rounded-md bg-[#151619] px-2.5 text-[12px] text-[#8f9298]\" data-kid=\"1-1-2-2\" data-name=\"conversation search field\">\n                <i class=\"ph ph-magnifying-glass text-[15px]\" data-kid=\"1-1-2-2-1\" data-name=\"search magnifying glass icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"search placeholder text\">\n                    Tìm hoặc bắt đầu cuộc trò chuyện\n                </span>\n            </div>\n            <div class=\"px-2 pt-4\" data-kid=\"1-1-2-3\" data-name=\"direct messages list section\">\n                <div class=\"flex items-center justify-between px-2 pb-2 text-[11px] font-extrabold uppercase tracking-[0.08em] text-[#94979d]\" data-kid=\"1-1-2-3-1\" data-name=\"direct messages section header\">\n                    <span data-kid=\"1-1-2-3-1-1\" data-name=\"section heading text\">\n                        Tin nhắn trực tiếp\n                    </span>\n                    <i class=\"ph ph-plus text-[15px]\" data-kid=\"1-1-2-3-1-2\" data-name=\"add conversation plus icon\">\n                    </i>\n                </div>\n                <div class=\"space-y-0.5\" data-kid=\"1-1-2-3-2\" data-name=\"conversation list\">\n                    <div class=\"flex h-11 items-center gap-3 rounded-md bg-[#3b3d44] px-2.5 text-sm font-semibold\" data-kid=\"1-1-2-3-2-1\" data-name=\"selected conversation row for Mai Thu\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#d890a1] text-[11px] font-bold text-[#262226]\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"conversation avatar for Mai Thu\">\n                            MT\n                        </span>\n                        <span class=\"truncate\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"conversation name label\">\n                            Mai Thu\n                        </span>\n                        <span class=\"ml-auto h-2 w-2 rounded-full bg-[#43c07a]\" data-kid=\"1-1-2-3-2-1-3\" data-name=\"online status indicator dot\">\n                        </span>\n                    </div>\n                    <div class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-sm text-[#b9bbc0]\" data-kid=\"1-1-2-3-2-2\" data-name=\"conversation row for Nam Khánh\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#82b6c9] text-[11px] font-bold text-[#1d262a]\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"conversation avatar for Nam Khánh\">\n                            NK\n                        </span>\n                        <span class=\"truncate\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"conversation name label\">\n                            Nam Khánh\n                        </span>\n                    </div>\n                    <div class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-sm text-[#b9bbc0]\" data-kid=\"1-1-2-3-2-3\" data-name=\"conversation row for Phương Anh\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#d6ae6d] text-[11px] font-bold text-[#2b251b]\" data-kid=\"1-1-2-3-2-3-1\" data-name=\"conversation avatar for Phương Anh\">\n                            PA\n                        </span>\n                        <span class=\"truncate\" data-kid=\"1-1-2-3-2-3-2\" data-name=\"conversation name label\">\n                            Phương Anh\n                        </span>\n                        <span class=\"ml-auto h-2 w-2 rounded-full bg-[#43c07a]\" data-kid=\"1-1-2-3-2-3-3\" data-name=\"online status indicator dot\">\n                        </span>\n                    </div>\n                    <div class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-sm text-[#b9bbc0]\" data-kid=\"1-1-2-3-2-4\" data-name=\"conversation row for Quốc Huy\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#877bc2] text-[11px] font-bold text-white\" data-kid=\"1-1-2-3-2-4-1\" data-name=\"conversation avatar for Quốc Huy\">\n                            QH\n                        </span>\n                        <span class=\"truncate\" data-kid=\"1-1-2-3-2-4-2\" data-name=\"conversation name label\">\n                            Quốc Huy\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-auto flex items-center gap-2.5 bg-[#18191c] px-3 py-3\" data-kid=\"1-1-2-4\" data-name=\"user profile footer card\">\n                <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#b987d5] text-[10px] font-bold text-[#201b24]\" data-kid=\"1-1-2-4-1\" data-name=\"user profile avatar\">\n                    LA\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-2-4-2\" data-name=\"user profile text block\">\n                    <div class=\"truncate text-[12px] font-bold\" data-kid=\"1-1-2-4-2-1\" data-name=\"user display name\">\n                        Lê An\n                    </div>\n                    <div class=\"text-[10px] text-[#43c07a]\" data-kid=\"1-1-2-4-2-2\" data-name=\"user presence status text\">\n                        Đang trực tuyến\n                    </div>\n                </div>\n                <i aria-label=\"Mic đã tắt\" class=\"ph ph-microphone-slash ml-auto text-[16px] text-[#afb1b6]\" data-kid=\"1-1-2-4-3\" data-name=\"muted microphone icon\">\n                </i>\n            </div>\n        </aside>\n        <section aria-label=\"Cuộc trò chuyện với Mai Thu\" class=\"flex min-w-0 flex-1 flex-col bg-[#27292d]\" data-kid=\"1-1-3\" data-name=\"chat conversation section\">\n            <header class=\"flex h-14 shrink-0 items-center gap-3 border-b border-[#202226] px-5\" data-kid=\"1-1-3-1\" data-name=\"conversation header bar\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#d890a1] text-[10px] font-bold text-[#262226]\" data-kid=\"1-1-3-1-1\" data-name=\"conversation contact avatar\">\n                    MT\n                </span>\n                <span class=\"text-sm font-bold\" data-kid=\"1-1-3-1-2\" data-name=\"conversation contact name\">\n                    Mai Thu\n                </span>\n                <span class=\"h-5 w-px bg-[#414349]\" data-kid=\"1-1-3-1-3\" data-name=\"header vertical divider\">\n                </span>\n                <span class=\"text-xs text-[#afb1b6]\" data-kid=\"1-1-3-1-4\" data-name=\"conversation type label\">\n                    Tin nhắn trực tiếp\n                </span>\n                <div class=\"ml-auto flex items-center gap-4 text-[#afb1b6]\" data-kid=\"1-1-3-1-5\" data-name=\"header action icons group\">\n                    <i class=\"ph ph-phone text-[19px]\" data-kid=\"1-1-3-1-5-1\" data-name=\"call phone icon\">\n                    </i>\n                    <i class=\"ph ph-video-camera text-[20px]\" data-kid=\"1-1-3-1-5-2\" data-name=\"video call icon\">\n                    </i>\n                    <i class=\"ph ph-magnifying-glass text-[19px]\" data-kid=\"1-1-3-1-5-3\" data-name=\"search conversation icon\">\n                    </i>\n                </div>\n            </header>\n            <div class=\"flex flex-1 flex-col justify-end overflow-hidden px-6 pb-5\" data-kid=\"1-1-3-2\" data-name=\"chat messages scroll area\">\n                <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-1-3-2-1\" data-name=\"incoming message from Mai Thu\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#d890a1] text-xs font-bold text-[#262226]\" data-kid=\"1-1-3-2-1-1\" data-name=\"message author avatar\">\n                        MT\n                    </span>\n                    <div data-kid=\"1-1-3-2-1-2\" data-name=\"message body content\">\n                        <div class=\"text-sm font-bold\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"message author name and timestamp\">\n                            Mai Thu\n                            <span class=\"ml-1 text-[10px] font-medium text-[#8e9197]\" data-kid=\"1-1-3-2-1-2-1-1\" data-name=\"message timestamp\">\n                                Hôm nay lúc 10:42\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[13px] text-[#d0d1d4]\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"message text content\">\n                            Chiều nay mình gửi bản demo để mọi người xem nhé.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mb-6 flex items-center gap-3\" data-kid=\"1-1-3-2-2\" data-name=\"outgoing message from Lê An\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#b987d5] text-[11px] font-bold text-[#201b24]\" data-kid=\"1-1-3-2-2-1\" data-name=\"message author avatar\">\n                        LA\n                    </span>\n                    <div data-kid=\"1-1-3-2-2-2\" data-name=\"message body content\">\n                        <div class=\"text-sm font-bold\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"message author name and timestamp\">\n                            Lê An\n                            <span class=\"ml-1 text-[10px] font-medium text-[#8e9197]\" data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"message timestamp\">\n                                Hôm nay lúc 10:44\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[13px] text-[#d0d1d4]\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"message text content\">\n                            Được nha, mình sẽ góp ý sau khi nhận được.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex h-11 items-center gap-3 rounded-lg bg-[#313338] px-3 text-[13px] text-[#898c92]\" data-kid=\"1-1-3-2-3\" data-name=\"message composer input row\">\n                    <i class=\"ph ph-plus-circle text-[20px]\" data-kid=\"1-1-3-2-3-1\" data-name=\"attach circle plus icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-3-2\" data-name=\"message composer placeholder text\">\n                        Nhắn tin cho @Mai Thu\n                    </span>\n                    <i class=\"ph ph-smiley ml-auto text-[19px]\" data-kid=\"1-1-3-2-3-3\" data-name=\"emoji smiley icon\">\n                    </i>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Thành viên trực tuyến\" class=\"w-[205px] shrink-0 border-l border-[#202226] bg-[#1e1f23] px-3 pt-16\" data-kid=\"1-1-4\" data-name=\"online members panel\">\n            <div class=\"mb-3 text-[10px] font-extrabold uppercase tracking-[0.08em] text-[#96999f]\" data-kid=\"1-1-4-1\" data-name=\"online members heading\">\n                Đang hoạt động — 3\n            </div>\n            <div class=\"space-y-4 text-xs text-[#c6c8cc]\" data-kid=\"1-1-4-2\" data-name=\"online members list\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-4-2-1\" data-name=\"online member row for Mai Thu\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#d890a1] text-[9px] font-bold text-[#262226]\" data-kid=\"1-1-4-2-1-1\" data-name=\"online member avatar\">\n                        MT\n                    </span>\n                    Mai Thu\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-4-2-2\" data-name=\"online member row for Nam Khánh\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#82b6c9] text-[9px] font-bold text-[#1d262a]\" data-kid=\"1-1-4-2-2-1\" data-name=\"online member avatar\">\n                        NK\n                    </span>\n                    Nam Khánh\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-4-2-3\" data-name=\"online member row for Phương Anh\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#d6ae6d] text-[9px] font-bold text-[#2b251b]\" data-kid=\"1-1-4-2-3-1\" data-name=\"online member avatar\">\n                        PA\n                    </span>\n                    Phương Anh\n                </div>\n            </div>\n        </aside>\n    </div>\n    <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[#08090b]/70\" data-kid=\"1-2\" data-name=\"modal backdrop overlay\">\n    </div>\n    <div class=\"absolute inset-0 flex items-center justify-center p-8\" data-kid=\"1-3\" data-name=\"modal centering wrapper\">\n        <section aria-labelledby=\"dialog-title\" aria-modal=\"true\" class=\"flex w-[560px] max-h-[calc(100%-32px)] flex-col overflow-hidden rounded-[10px] bg-[#313338] shadow-[0_20px_60px_rgba(0,0,0,0.42)]\" data-kid=\"1-3-1\" data-name=\"create group dialog\" role=\"dialog\">\n            <header class=\"flex items-start justify-between px-6 pb-4 pt-6\" data-kid=\"1-3-1-1\" data-name=\"dialog header\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"dialog title block\">\n                    <h1 class=\"text-[21px] font-extrabold leading-7 tracking-[-0.02em]\" data-kid=\"1-3-1-1-1-1\" data-name=\"dialog title heading\" id=\"dialog-title\">\n                        Tạo nhóm\n                    </h1>\n                    <p class=\"mt-1 text-[13px] text-[#afb1b6]\" data-kid=\"1-3-1-1-1-2\" data-name=\"dialog subtitle description\">\n                        Chọn người bạn muốn trò chuyện cùng.\n                    </p>\n                </div>\n                <button aria-label=\"Đóng hộp thoại\" class=\"-mr-1 -mt-1 flex h-8 w-8 items-center justify-center rounded-md text-[#aeb0b6] hover:bg-[#414349] hover:text-white\" data-kid=\"1-3-1-1-2\" data-name=\"dialog close button\">\n                    <i class=\"ph ph-x text-[19px]\" data-kid=\"1-3-1-1-2-1\" data-name=\"cross close icon\">\n                    </i>\n                </button>\n            </header>\n            <div class=\"flex-1 overflow-y-auto px-6 pb-5\" data-kid=\"1-3-1-2\" data-name=\"dialog scrollable body\">\n                <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-3-1-2-1\" data-name=\"group profile row\">\n                    <button aria-label=\"Thêm ảnh nhóm\" class=\"flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border border-dashed border-[#666970] bg-[#27292d] text-[#afb1b6] hover:border-[#8d9097]\" data-kid=\"1-3-1-2-1-1\" data-name=\"group avatar upload button\">\n                        <i class=\"ph ph-camera-plus text-[21px]\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"camera add photo icon\">\n                        </i>\n                    </button>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-1-2\" data-name=\"group name input group\">\n                        <label class=\"mb-1.5 block text-[12px] font-bold text-[#dcdddf]\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"group name label\" for=\"group-name\">\n                            Tên nhóm\n                            <span class=\"font-medium text-[#9b9da3]\" data-kid=\"1-3-1-2-1-2-1-1\" data-name=\"label optional note\">\n                                (không bắt buộc)\n                            </span>\n                        </label>\n                        <input class=\"h-10 w-full rounded-md border border-[#202226] bg-[#27292d] px-3 text-[13px] text-[#eaebee] outline-none focus:border-[#5e68f7]\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"group name text input\" id=\"group-name\" type=\"text\" value=\"Nhóm cuối tuần\"/>\n                    </div>\n                </div>\n                <div class=\"mb-2 flex items-end justify-between gap-3\" data-kid=\"1-3-1-2-2\" data-name=\"add members section header\">\n                    <label class=\"text-[12px] font-bold text-[#dcdddf]\" data-kid=\"1-3-1-2-2-1\" data-name=\"member section label\" for=\"member-search\">\n                        Thêm thành viên\n                    </label>\n                    <span class=\"text-[11px] text-[#92959b]\" data-kid=\"1-3-1-2-2-2\" data-name=\"member limit hint\">\n                        Tối đa 10 người\n                    </span>\n                </div>\n                <div class=\"flex h-10 items-center gap-2 rounded-md border border-[#202226] bg-[#27292d] px-3 focus-within:border-[#5e68f7]\" data-kid=\"1-3-1-2-3\" data-name=\"member search field\">\n                    <i class=\"ph ph-magnifying-glass text-[16px] text-[#afb1b6]\" data-kid=\"1-3-1-2-3-1\" data-name=\"search magnifying glass icon\">\n                    </i>\n                    <input aria-label=\"Tìm thành viên theo tên\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[#eaebee] outline-none placeholder:text-[#85888e]\" data-kid=\"1-3-1-2-3-2\" data-name=\"member name search input\" id=\"member-search\" placeholder=\"Tìm theo tên\" type=\"search\"/>\n                    <kbd class=\"rounded bg-[#3b3d44] px-1.5 py-0.5 text-[10px] text-[#afb1b6]\" data-kid=\"1-3-1-2-3-3\" data-name=\"keyboard shortcut hint badge\">\n                        ⌘ K\n                    </kbd>\n                </div>\n                <div aria-live=\"polite\" class=\"mt-3 flex items-center gap-2 rounded-md bg-[#27292d] px-2.5 py-2\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4\" data-name=\"selected members summary bar\" data-reason=\"member count and names re-rendered by selection script\">\n                    <div class=\"flex -space-x-2\" data-kid=\"1-3-1-2-4-1\" data-name=\"selected member avatars stack\">\n                        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-[#27292d] bg-[#d890a1] text-[8px] font-bold text-[#262226]\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"selected avatar for LN\">\n                            LN\n                        </span>\n                        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-[#27292d] bg-[#82b6c9] text-[8px] font-bold text-[#1d262a]\" data-kid=\"1-3-1-2-4-1-2\" data-name=\"selected avatar for MK\">\n                            MK\n                        </span>\n                        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-[#27292d] bg-[#d6ae6d] text-[8px] font-bold text-[#2b251b]\" data-kid=\"1-3-1-2-4-1-3\" data-name=\"selected avatar for BA\">\n                            BA\n                        </span>\n                    </div>\n                    <span class=\"min-w-0 text-[11px] text-[#c8cacf]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4-2\" data-name=\"selected members count and names\" data-reason=\"count and member name list re-rendered by selection script\">\n                        <strong class=\"font-bold text-[#eaebee]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4-2-1\" data-name=\"selected count emphasis\" data-reason=\"count text re-rendered by selection script\">\n                            3 đã chọn\n                        </strong>\n                        <span class=\"text-[#9b9da3]\" data-kid=\"1-3-1-2-4-2-2\" data-name=\"member names separator dot\">\n                            ·\n                        </span>\n                        Ngọc Linh, Minh Khoa và Bảo Anh\n                    </span>\n                </div>\n                <div aria-label=\"Danh sách thành viên\" class=\"mt-3 max-h-[252px] overflow-y-auto pr-1\" data-kid=\"1-3-1-2-5\" data-name=\"member selection list\" role=\"group\">\n                    <button aria-label=\"Bỏ chọn Trần Ngọc Linh\" aria-pressed=\"true\" class=\"flex min-h-[52px] w-full items-center gap-3 rounded-md bg-[#3b3d44] px-2.5 text-left\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-1\" data-name=\"selected member row for Trần Ngọc Linh\" data-reason=\"row highlight and check state toggled by selection script\">\n                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#d890a1] text-[10px] font-extrabold text-[#262226]\" data-kid=\"1-3-1-2-5-1-1\" data-name=\"member avatar\">\n                            LN\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-5-1-2\" data-name=\"member info block\">\n                            <span class=\"block truncate text-[13px] font-bold text-[#eaebee]\" data-kid=\"1-3-1-2-5-1-2-1\" data-name=\"member display name\">\n                                Trần Ngọc Linh\n                            </span>\n                            <span class=\"block text-[11px] text-[#43c07a]\" data-kid=\"1-3-1-2-5-1-2-2\" data-name=\"member presence status\">\n                                Đang hoạt động\n                            </span>\n                        </span>\n                        <span class=\"flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#5e68f7] text-white\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-1-3\" data-name=\"selected check state circle\" data-reason=\"check icon visibility toggled by selection script\">\n                            <i class=\"ph ph-check text-[12px]\" data-kid=\"1-3-1-2-5-1-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Chọn Nguyễn Minh Khoa\" aria-pressed=\"false\" class=\"flex min-h-[52px] w-full items-center gap-3 rounded-md px-2.5 text-left hover:bg-[#34363b]\" data-kid=\"1-3-1-2-5-2\" data-name=\"unselected member row for Nguyễn Minh Khoa\">\n                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#82b6c9] text-[10px] font-extrabold text-[#1d262a]\" data-kid=\"1-3-1-2-5-2-1\" data-name=\"member avatar\">\n                            MK\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-5-2-2\" data-name=\"member info block\">\n                            <span class=\"block truncate text-[13px] font-bold text-[#dcdddf]\" data-kid=\"1-3-1-2-5-2-2-1\" data-name=\"member display name\">\n                                Nguyễn Minh Khoa\n                            </span>\n                            <span class=\"block text-[11px] text-[#8f9298]\" data-kid=\"1-3-1-2-5-2-2-2\" data-name=\"member role description\">\n                                Thiết kế sản phẩm\n                            </span>\n                        </span>\n                        <span class=\"h-[18px] w-[18px] rounded-full border border-[#666970]\" data-kid=\"1-3-1-2-5-2-3\" data-name=\"unselected radio circle\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Bỏ chọn Lê Bảo Anh\" aria-pressed=\"true\" class=\"flex min-h-[52px] w-full items-center gap-3 rounded-md bg-[#3b3d44] px-2.5 text-left\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-3\" data-name=\"selected member row for Lê Bảo Anh\" data-reason=\"row highlight and check state toggled by selection script\">\n                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#d6ae6d] text-[10px] font-extrabold text-[#2b251b]\" data-kid=\"1-3-1-2-5-3-1\" data-name=\"member avatar\">\n                            BA\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-5-3-2\" data-name=\"member info block\">\n                            <span class=\"block truncate text-[13px] font-bold text-[#eaebee]\" data-kid=\"1-3-1-2-5-3-2-1\" data-name=\"member display name\">\n                                Lê Bảo Anh\n                            </span>\n                            <span class=\"block text-[11px] text-[#8f9298]\" data-kid=\"1-3-1-2-5-3-2-2\" data-name=\"member last active note\">\n                                Lần cuối hoạt động hôm nay\n                            </span>\n                        </span>\n                        <span class=\"flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#5e68f7] text-white\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-3-3\" data-name=\"selected check state circle\" data-reason=\"check icon visibility toggled by selection script\">\n                            <i class=\"ph ph-check text-[12px]\" data-kid=\"1-3-1-2-5-3-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Chọn Phạm Quang Huy\" aria-pressed=\"false\" class=\"flex min-h-[52px] w-full items-center gap-3 rounded-md px-2.5 text-left hover:bg-[#34363b]\" data-kid=\"1-3-1-2-5-4\" data-name=\"unselected member row for Phạm Quang Huy\">\n                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#877bc2] text-[10px] font-extrabold text-white\" data-kid=\"1-3-1-2-5-4-1\" data-name=\"member avatar\">\n                            QH\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-5-4-2\" data-name=\"member info block\">\n                            <span class=\"block truncate text-[13px] font-bold text-[#dcdddf]\" data-kid=\"1-3-1-2-5-4-2-1\" data-name=\"member display name\">\n                                Phạm Quang Huy\n                            </span>\n                            <span class=\"block text-[11px] text-[#8f9298]\" data-kid=\"1-3-1-2-5-4-2-2\" data-name=\"member role description\">\n                                Lập trình viên\n                            </span>\n                        </span>\n                        <span class=\"h-[18px] w-[18px] rounded-full border border-[#666970]\" data-kid=\"1-3-1-2-5-4-3\" data-name=\"unselected radio circle\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Bỏ chọn Đỗ Hoàng Nam\" aria-pressed=\"true\" class=\"flex min-h-[52px] w-full items-center gap-3 rounded-md bg-[#3b3d44] px-2.5 text-left\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-5\" data-name=\"selected member row for Đỗ Hoàng Nam\" data-reason=\"row highlight and check state toggled by selection script\">\n                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#91bd8f] text-[10px] font-extrabold text-[#1f281e]\" data-kid=\"1-3-1-2-5-5-1\" data-name=\"member avatar\">\n                            HN\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-2-5-5-2\" data-name=\"member info block\">\n                            <span class=\"block truncate text-[13px] font-bold text-[#eaebee]\" data-kid=\"1-3-1-2-5-5-2-1\" data-name=\"member display name\">\n                                Đỗ Hoàng Nam\n                            </span>\n                            <span class=\"block text-[11px] text-[#43c07a]\" data-kid=\"1-3-1-2-5-5-2-2\" data-name=\"member presence status\">\n                                Đang hoạt động\n                            </span>\n                        </span>\n                        <span class=\"flex h-[18px] w-[18px] items-center justify-center rounded-full bg-[#5e68f7] text-white\" data-dynamic=\"true\" data-kid=\"1-3-1-2-5-5-3\" data-name=\"selected check state circle\" data-reason=\"check icon visibility toggled by selection script\">\n                            <i class=\"ph ph-check text-[12px]\" data-kid=\"1-3-1-2-5-5-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <footer class=\"flex items-center justify-between border-t border-[#26282c] px-6 py-4\" data-kid=\"1-3-1-3\" data-name=\"dialog footer actions\">\n                <p class=\"max-w-[280px] text-[11px] leading-4 text-[#989ba1]\" data-kid=\"1-3-1-3-1\" data-name=\"footer informational note\">\n                    Nhóm sẽ xuất hiện trong danh sách tin nhắn của bạn.\n                </p>\n                <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-3-1-3-2\" data-name=\"footer action buttons group\">\n                    <button aria-label=\"Hủy tạo nhóm\" class=\"h-9 rounded-md px-3.5 text-[13px] font-bold text-[#dcdddf] hover:underline\" data-kid=\"1-3-1-3-2-1\" data-name=\"cancel button\">\n                        Hủy\n                    </button>\n                    <button aria-label=\"Tạo nhóm chat với 3 thành viên\" class=\"h-9 rounded-md bg-[#5e68f7] px-4 text-[13px] font-bold text-white hover:bg-[#515be7] focus:outline-none focus:ring-2 focus:ring-[#c0c4ff]\" data-dynamic=\"true\" data-kid=\"1-3-1-3-2-2\" data-name=\"create group primary button\" data-reason=\"member count in aria-label recomputed by selection script\">\n                        Tạo nhóm\n                    </button>\n                </div>\n            </footer>\n        </section>\n    </div>\n</div>\n",
