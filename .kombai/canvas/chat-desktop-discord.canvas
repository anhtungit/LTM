iv>\n                        <div class=\"mb-6 rounded-md border border-[#4e5058] bg-[#2b2d32] px-3.5 py-3 text-[12px] leading-5 text-[#b5bac1]\" data-kid=\"1-3-2-2-1-1-4\" data-name=\"preview mode data notice\">\n                            <span class=\"font-bold text-[#e2e3e5]\" data-kid=\"1-3-2-2-1-1-4-1\" data-name=\"notice label text\">\n                                Dữ liệu mẫu.\n                            </span>\n                            Thay đổi hiện chỉ nằm trong bản xem trước; dịch vụ hồ sơ và tải ảnh chưa được kết nối.\n                        </div>\n                    </div>\n                </div>\n                <footer class=\"flex h-[72px] shrink-0 items-center justify-between border-t border-black/25 bg-[#23252a] px-8\" data-kid=\"1-3-2-2-2\" data-name=\"form actions footer\">\n                    <div class=\"flex items-center gap-2 text-[13px] text-[#e4e5e7]\" data-kid=\"1-3-2-2-2-1\" data-name=\"unsaved changes status container\">\n                        <i aria-hidden=\"true\" class=\"ph ph-info h-[18px] w-[18px] text-lg text-[#afb1b6]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"info icon\">\n                        </i>\n                        <span data-kid=\"1-3-2-2-2-1-2\" data-name=\"unsaved changes notice text\">\n                            Có thay đổi chưa lưu\n                        </span>\n                        <span class=\"text-[#8e9299]\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"preview-only qualifier text\">\n                            · chỉ áp dụng cho bản xem trước\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-2\" data-name=\"footer actions group\">\n                        <button class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[#b5bac1] hover:bg-white/5\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"cancel button\">\n                            Hủy\n                        </button>\n                        <button class=\"flex h-9 items-center gap-2 rounded-md bg-[var(--ds-accent)] px-4 text-[13px] font-extrabold text-white hover:bg-[#5059e8]\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"save changes button\">\n                            <i aria-hidden=\"true\" class=\"ph ph-check h-4 w-4 text-base text-white\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"checkmark icon\">\n                            </i>\n                            Lưu thay đổi\n                        </button>\n                    </div>\n                </footer>\n            </section>\n        </div>\n    </main>\n    <div class=\"absolute inset-0 z-20 flex items-center justify-center bg-black/45\" data-kid=\"1-4\" data-name=\"modal backdrop overlay\" role=\"presentation\">\n        <section aria-labelledby=\"crop-title\" aria-modal=\"true\" class=\"w-[420px] rounded-[10px] bg-[#2b2d32] shadow-[0_16px_48px_rgba(0,0,0,0.45)]\" data-kid=\"1-4-1\" data-name=\"avatar crop dialog\" role=\"dialog\">\n            <div class=\"flex items-start justify-between px-6 pt-5\" data-kid=\"1-4-1-1\" data-name=\"dialog header\">\n                <div data-kid=\"1-4-1-1-1\" data-name=\"dialog title block\">\n                    <h2 class=\"text-[18px] font-extrabold text-[#f2f3f5]\" data-kid=\"1-4-1-1-1-1\" data-name=\"dialog title heading\" id=\"crop-title\">\n                        Cắt ảnh đại diện\n                    </h2>\n                    <p class=\"mt-1 text-[13px] text-[#b5bac1]\" data-kid=\"1-4-1-1-1-2\" data-name=\"dialog subtitle\">\n                        Xem lại ảnh trước khi dùng.\n                    </p>\n                </div>\n                <button aria-label=\"Đóng xem trước\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#b5bac1] hover:bg-white/5\" data-kid=\"1-4-1-1-2\" data-name=\"close dialog button\">\n                    <i aria-hidden=\"true\" class=\"ph ph-x h-5 w-5 text-xl text-[#b5bac1]\" data-kid=\"1-4-1-1-2-1\" data-name=\"close X icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center px-6 pt-5\" data-kid=\"1-4-1-2\" data-name=\"crop preview area\">\n                <div class=\"relative flex h-[196px] w-[196px] items-center justify-center rounded-full border border-dashed border-[#8e9299] bg-[#202226] p-2\" data-kid=\"1-4-1-2-1\" data-name=\"crop circle frame with corner handles\">\n                    <div class=\"h-[176px] w-[176px] overflow-hidden rounded-full\" data-kid=\"1-4-1-2-1-1\" data-name=\"crop circle clipping mask\">\n                        <img alt=\"Ảnh mẫu xem trước trong vùng cắt avatar\" class=\"h-full w-full scale-[1.12] object-cover\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"preview image inside crop\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/360?u=mai-linh\"/>\n                    </div>\n                    <span class=\"pointer-events-none absolute left-1/2 top-0 h-2 w-2 -translate-x-1/2 rounded-full bg-white\" data-kid=\"1-4-1-2-1-2\" data-name=\"top crop handle dot\">\n                    </span>\n                    <span class=\"pointer-events-none absolute bottom-0 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-white\" data-kid=\"1-4-1-2-1-3\" data-name=\"bottom crop handle dot\">\n                    </span>\n                    <span class=\"pointer-events-none absolute left-0 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-white\" data-kid=\"1-4-1-2-1-4\" data-name=\"left crop handle dot\">\n                    </span>\n                    <span class=\"pointer-events-none absolute right-0 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-white\" data-kid=\"1-4-1-2-1-5\" data-name=\"right crop handle dot\">\n                    </span>\n                </div>\n                <div class=\"mt-4 flex w-full items-center justify-between text-[12px] text-[#b5bac1]\" data-kid=\"1-4-1-2-2\" data-name=\"crop controls row\">\n                    <span data-kid=\"1-4-1-2-2-1\" data-name=\"preview image label\">\n                        Ảnh mẫu\n                    </span>\n                    <button class=\"flex items-center gap-1.5 rounded px-2 py-1 font-semibold text-[#c3c7ff] hover:bg-white/5\" data-kid=\"1-4-1-2-2-2\" data-name=\"adjust crop button\">\n                        <i aria-hidden=\"true\" class=\"ph ph-arrows-out-cardinal h-4 w-4 text-base text-[#c3c7ff]\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"expand crop icon\">\n                        </i>\n                        Điều chỉnh vùng cắt\n                    </button>\n                </div>\n            </div>\n            <div class=\"mx-6 mt-4 rounded-md bg-[#202226] px-3 py-2.5 text-[12px] leading-[18px] text-[#b5bac1]\" data-kid=\"1-4-1-3\" data-name=\"preview-only notice in dialog\">\n                Ảnh chỉ được hiển thị trong bản xem trước. Dịch vụ lưu hồ sơ chưa được kết nối.\n            </div>\n            <div class=\"flex items-center justify-between px-6 pb-5 pt-4\" data-kid=\"1-4-1-4\" data-name=\"dialog footer actions\">\n                <button class=\"rounded-md px-3 py-2 text-[13px] font-bold text-[#c3c7ff] hover:bg-white/5\" data-kid=\"1-4-1-4-1\" data-name=\"choose different image button\">\n                    Chọn ảnh khác\n                </button>\n                <button class=\"rounded-md bg-[var(--ds-accent)] px-4 py-2 text-[13px] font-extrabold text-white hover:bg-[#5059e8]\" data-kid=\"1-4-1-4-2\" data-name=\"use this image button\">\n                    Dùng ảnh này\n                </button>\n            </div>\n        </section>\n    </div>\n</div>\n",
