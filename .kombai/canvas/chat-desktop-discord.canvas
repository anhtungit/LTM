      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"min-h-screen w-full flex items-center justify-center bg-[#151619] px-6 py-10 text-[#EAEBEE]\" data-kid=\"1\" data-name=\"page layout container centered on dark background\" style=\"font-family:'Nunito Sans', sans-serif;\">\n    <main class=\"w-full max-w-[448px] rounded-xl bg-[#1E1F23] px-10 py-9 shadow-[0_12px_36px_rgba(0,0,0,0.24)]\" data-kid=\"1-1\" data-name=\"login card panel\">\n        <header class=\"mb-8 flex flex-col items-center text-center\" data-kid=\"1-1-1\" data-name=\"card header with app branding\">\n            <div class=\"mb-3 flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#5E68F7] text-2xl text-white\" data-kid=\"1-1-1-1\" data-name=\"app logo badge with chat icon\">\n                <i aria-hidden=\"true\" class=\"ph ph-chat-circle-dots\" data-kid=\"1-1-1-1-1\" data-name=\"chat bubble icon\">\n                </i>\n            </div>\n            <p class=\"text-[14px] font-bold tracking-[0.01em] text-[#EAEBEE]\" data-kid=\"1-1-1-2\" data-name=\"app product name caption\">\n                Chat đa luồng\n            </p>\n            <h1 class=\"mt-7 text-[25px] font-extrabold leading-tight text-[#EAEBEE]\" data-kid=\"1-1-1-3\" data-name=\"login card headline\">\n                Chào mừng trở lại\n            </h1>\n            <p class=\"mt-2 text-[14px] text-[#AFB1B6]\" data-kid=\"1-1-1-4\" data-name=\"login card subtitle text\">\n                Đăng nhập để tiếp tục trò chuyện cùng nhóm của bạn.\n            </p>\n        </header>\n        <form aria-label=\"Đăng nhập\" class=\"space-y-5\" data-kid=\"1-1-2\" data-name=\"login form\">\n            <div data-kid=\"1-1-2-1\" data-name=\"email input field group\">\n                <label class=\"mb-2 block text-[13px] font-bold text-[#D5D6D8]\" data-kid=\"1-1-2-1-1\" data-name=\"email field label\" for=\"email\">\n                    Email\n                    <span class=\"text-[#F54748]\" data-kid=\"1-1-2-1-1-1\" data-name=\"required field asterisk\">\n                        *\n                    </span>\n                </label>\n                <input autocomplete=\"email\" class=\"h-11 w-full rounded-lg border border-[#3B3D44] bg-[#313338] px-3.5 text-[14px] text-[#EAEBEE] outline-none placeholder:text-[#85878D] focus:border-[#5E68F7] focus:ring-2 focus:ring-[#5E68F7]/25\" data-kid=\"1-1-2-1-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"ten@vi-du.com\" type=\"email\"/>\n            </div>\n            <div data-kid=\"1-1-2-2\" data-name=\"password input field group\">\n                <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-1-2-2-1\" data-name=\"password label row with link\">\n                    <label class=\"block text-[13px] font-bold text-[#D5D6D8]\" data-kid=\"1-1-2-2-1-1\" data-name=\"password field label\" for=\"password\">\n                        Mật khẩu\n                        <span class=\"text-[#F54748]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"required field asterisk\">\n                            *\n                        </span>\n                    </label>\n                    <a class=\"text-[13px] font-semibold text-[#8F98FF] hover:underline\" data-kid=\"1-1-2-2-1-2\" data-name=\"forgot password link\" href=\"#\">\n                        Quên mật khẩu?\n                    </a>\n                </div>\n                <div class=\"relative\" data-kid=\"1-1-2-2-2\" data-name=\"password input with visibility toggle\">\n                    <input autocomplete=\"current-password\" class=\"h-11 w-full rounded-lg border border-[#3B3D44] bg-[#313338] px-3.5 pr-11 text-[14px] text-[#EAEBEE] outline-none placeholder:text-[#85878D] focus:border-[#5E68F7] focus:ring-2 focus:ring-[#5E68F7]/25\" data-kid=\"1-1-2-2-2-1\" data-name=\"password input field\" id=\"password\" name=\"password\" placeholder=\"Nhập mật khẩu\" type=\"password\"/>\n                    <button aria-label=\"Hiện mật khẩu\" class=\"absolute right-0 top-0 flex h-11 w-11 items-center justify-center rounded-r-lg text-lg text-[#AFB1B6] hover:text-[#EAEBEE]\" data-kid=\"1-1-2-2-2-2\" data-name=\"show password toggle button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ph ph-eye\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"eye icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2.5 rounded-lg bg-[#27292D] px-3.5 py-3 text-[12px] leading-[1.45] text-[#AFB1B6]\" data-kid=\"1-1-2-3\" data-name=\"server status warning callout\">\n                <i aria-hidden=\"true\" class=\"ph ph-info flex-none text-base text-[#F0BB3B]\" data-kid=\"1-1-2-3-1\" data-name=\"info warning icon\">\n                </i>\n                <p data-kid=\"1-1-2-3-2\" data-name=\"server unavailable notice text\">\n                    Máy chủ chưa được cấu hình. Đăng nhập sẽ khả dụng sau khi tích hợp kết nối.\n                </p>\n            </div>\n            <div class=\"space-y-3 pt-1\" data-kid=\"1-1-2-4\" data-name=\"form action buttons group\">\n                <button class=\"flex h-11 w-full items-center justify-center rounded-lg bg-[#5E68F7] px-4 text-[14px] font-bold text-white hover:bg-[#5059E8] focus:outline-none focus:ring-2 focus:ring-[#8F98FF] focus:ring-offset-2 focus:ring-offset-[#1E1F23]\" data-kid=\"1-1-2-4-1\" data-name=\"primary sign-in button\" type=\"button\">\n                    Đăng nhập\n                </button>\n                <button class=\"flex h-11 w-full items-center justify-center rounded-lg border border-[#3B3D44] bg-transparent px-4 text-[14px] font-semibold text-[#EAEBEE] hover:bg-[#27292D] focus:outline-none focus:ring-2 focus:ring-[#5E68F7]\" data-kid=\"1-1-2-4-2\" data-name=\"secondary create account button\" type=\"button\">\n                    Tạo tài khoản\n                </button>\n            </div>\n        </form>\n        <footer class=\"mt-7 border-t border-[#34363C] pt-5 text-center text-[12px] text-[#85878D]\" data-kid=\"1-1-3\" data-name=\"card footer note text\">\n            Kết nối tới máy chủ chat của bạn\n        </footer>\n    </main>\n</div>\n",
