    "var_0902bd43dbea": {
      "type": "variant",
      "label": "07 — Hồ sơ & avatar",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13444,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"relative flex h-[900px] w-full overflow-hidden bg-[var(--ds-transcript)] text-[var(--ds-text)]\" data-kid=\"1\" data-name=\"Discord-like app layout container\" style=\"--ds-rail:#151619;--ds-sidebar:#1e1f23;--ds-transcript:#27292d;--ds-composer:#313338;--ds-selected:#3b3d44;--ds-text:#eaebee;--ds-muted:#afb1b6;--ds-accent:#5e68f7;--ds-green:#43c07a;font-family:'Nunito Sans',sans-serif;\">\n    <aside aria-label=\"Thanh máy chủ\" class=\"flex h-full w-[72px] shrink-0 flex-col items-center gap-3 bg-[var(--ds-rail)] py-4\" data-kid=\"1-1\" data-name=\"server navigation rail\">\n        <button aria-label=\"Tin nhắn\" class=\"relative flex h-12 w-12 items-center justify-center rounded-[17px] bg-[var(--ds-accent)] text-white\" data-kid=\"1-1-1\" data-name=\"messages server button\" title=\"Tin nhắn\">\n            <i aria-hidden=\"true\" class=\"ph ph-chat-circle-dots h-6 w-6 text-2xl text-white\" data-kid=\"1-1-1-1\" data-name=\"messages chat icon\">\n            </i>\n        </button>\n        <div class=\"h-px w-8 bg-white/10\" data-kid=\"1-1-2\" data-name=\"server rail divider line\">\n        </div>\n        <button aria-label=\"Nhóm Mây\" class=\"relative flex h-12 w-12 items-center justify-center rounded-2xl bg-[#3b3d44] text-[15px] font-extrabold text-white\" data-kid=\"1-1-3\" data-name=\"active group server button with indicator\" title=\"Nhóm Mây\">\n            <span class=\"absolute -left-[12px] h-8 w-1 rounded-r bg-white\" data-kid=\"1-1-3-1\" data-name=\"active server left indicator bar\">\n            </span>\n            M\n        </button>\n        <button aria-label=\"Nhóm Thiết kế\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#34363b] text-[15px] font-bold text-[#d4d5d8] hover:rounded-[17px] hover:bg-[#45484f]\" data-kid=\"1-1-4\" data-name=\"design group server button\" title=\"Nhóm Thiết kế\">\n            T\n        </button>\n        <button aria-label=\"Nhóm Học tập\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#34363b] text-[15px] font-bold text-[#d4d5d8] hover:rounded-[17px] hover:bg-[#45484f]\" data-kid=\"1-1-5\" data-name=\"study group server button\" title=\"Nhóm Học tập\">\n            H\n        </button>\n        <button aria-label=\"Thêm nhóm\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl text-[#43c07a] hover:rounded-[17px] hover:bg-[#23262a]\" data-kid=\"1-1-6\" data-name=\"add group server button\" title=\"Thêm nhóm\">\n            <i aria-hidden=\"true\" class=\"ph ph-plus h-6 w-6 text-2xl text-[#43c07a]\" data-kid=\"1-1-6-1\" data-name=\"add group plus icon\">\n            </i>\n        </button>\n        <button aria-label=\"Khám phá nhóm\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl text-[#43c07a] hover:rounded-[17px] hover:bg-[#23262a]\" data-kid=\"1-1-7\" data-name=\"discover groups button\" title=\"Khám phá nhóm\">\n            <i aria-hidden=\"true\" class=\"ph ph-compass h-6 w-6 text-2xl text-[#43c07a]\" data-kid=\"1-1-7-1\" data-name=\"discover groups compass icon\">\n            </i>\n        </button>\n        <div class=\"mt-auto flex flex-col gap-3\" data-kid=\"1-1-8\" data-name=\"server rail bottom action container\">\n            <button aria-label=\"Tải ứng dụng\" class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#34363b] text-[#afb1b6] hover:bg-[#45484f]\" data-kid=\"1-1-8-1\" data-name=\"download app button\">\n                <i aria-hidden=\"true\" class=\"ph ph-download-simple h-5 w-5 text-xl text-[#afb1b6]\" data-kid=\"1-1-8-1-1\" data-name=\"download icon\">\n                </i>\n            </button>\n        </div>\n    </aside>\n    <aside aria-label=\"Điều hướng trò chuyện\" class=\"flex h-full w-[240px] shrink-0 flex-col bg-[var(--ds-sidebar)]\" data-kid=\"1-2\" data-name=\"chat navigation sidebar\">\n        <div class=\"flex h-14 items-center justify-between border-b border-black/15 px-4\" data-kid=\"1-2-1\" data-name=\"private messages header bar\">\n            <span class=\"text-[15px] font-bold text-[#f2f3f5]\" data-kid=\"1-2-1-1\" data-name=\"private messages header title\">\n                Tin nhắn riêng\n            </span>\n            <button aria-label=\"Tạo tin nhắn\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#b5bac1] hover:bg-white/5\" data-kid=\"1-2-1-2\" data-name=\"new message button\">\n                <i aria-hidden=\"true\" class=\"ph ph-note-pencil h-5 w-5 text-xl text-[#b5bac1]\" data-kid=\"1-2-1-2-1\" data-name=\"new message pencil icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"px-3 pt-4\" data-kid=\"1-2-2\" data-name=\"search area container\">\n            <div class=\"flex h-9 items-center gap-2 rounded-md bg-[#151619]/70 px-2.5 text-[#8f9299]\" data-kid=\"1-2-2-1\" data-name=\"chat search field\">\n                <i aria-hidden=\"true\" class=\"ph ph-magnifying-glass h-4 w-4 text-base text-[#8f9299]\" data-kid=\"1-2-2-1-1\" data-name=\"search magnifier icon\">\n                </i>\n                <span class=\"text-[13px]\" data-kid=\"1-2-2-1-2\" data-name=\"search placeholder text\">\n                    Tìm hoặc bắt đầu cuộc trò chuyện\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Tin nhắn\" class=\"flex flex-col gap-1 px-2 pt-4\" data-kid=\"1-2-3\" data-name=\"main channels navigation\">\n            <button class=\"flex h-10 items-center gap-3 rounded-md px-3 text-left text-[14px] font-semibold text-[#d7d9dc] hover:bg-white/5\" data-kid=\"1-2-3-1\" data-name=\"people channel nav button\">\n                <i aria-hidden=\"true\" class=\"ph ph-users-three h-5 w-5 text-xl text-[#b5bac1]\" data-kid=\"1-2-3-1-1\" data-name=\"people channel icon\">\n                </i>\n                Bạn bè\n            </button>\n            <button class=\"flex h-10 items-center gap-3 rounded-md bg-[var(--ds-selected)] px-3 text-left text-[14px] font-semibold text-white\" data-kid=\"1-2-3-2\" data-name=\"messages channel nav button (selected)\">\n                <i aria-hidden=\"true\" class=\"ph ph-chat-centered-text h-5 w-5 text-xl text-white\" data-kid=\"1-2-3-2-1\" data-name=\"messages channel icon\">\n                </i>\n                Tin nhắn\n            </button>\n        </nav>\n        <div class=\"mt-5 flex items-center justify-between px-4 pb-2 text-[11px] font-extrabold tracking-[0.06em] text-[#8e9299]\" data-kid=\"1-2-4\" data-name=\"recent messages section header\">\n            <span data-kid=\"1-2-4-1\" data-name=\"section label text\">\n                TIN NHẮN GẦN ĐÂY\n            </span>\n            <button aria-label=\"Tạo nhóm\" class=\"rounded p-1 text-[#afb1b6] hover:bg-white/5\" data-kid=\"1-2-4-2\" data-name=\"create group button\">\n                <i aria-hidden=\"true\" class=\"ph ph-plus h-4 w-4 text-base text-[#afb1b6]\" data-kid=\"1-2-4-2-1\" data-name=\"create group plus icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"flex flex-col gap-0.5 px-2\" data-kid=\"1-2-5\" data-name=\"recent DM list container\">\n            <button class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-left hover:bg-white/5\" data-kid=\"1-2-5-1\" data-name=\"Mai Linh DM conversation row\">\n                <img alt=\"Ảnh đại diện Mai Linh\" class=\"h-8 w-8 rounded-full object-cover\" data-kid=\"1-2-5-1-1\" data-name=\"DM user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=mai-linh\"/>\n                <span class=\"min-w-0 flex-1 truncate text-[14px] font-semibold text-[#d7d9dc]\" data-kid=\"1-2-5-1-2\" data-name=\"DM user display name\">\n                    Mai Linh\n                </span>\n                <span class=\"h-2 w-2 rounded-full bg-[var(--ds-green)]\" data-kid=\"1-2-5-1-3\" data-name=\"online status indicator dot\">\n                </span>\n            </button>\n            <button class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-left hover:bg-white/5\" data-kid=\"1-2-5-2\" data-name=\"An Nguyễn DM conversation row\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#7455a5] text-[11px] font-bold text-white\" data-kid=\"1-2-5-2-1\" data-name=\"DM initials avatar\">\n                    AN\n                </span>\n                <span class=\"min-w-0 flex-1 truncate text-[14px] font-semibold text-[#b5bac1]\" data-kid=\"1-2-5-2-2\" data-name=\"DM user display name\">\n                    An Nguyễn\n                </span>\n                <span class=\"h-2 w-2 rounded-full bg-[#8e9299]\" data-kid=\"1-2-5-2-3\" data-name=\"offline status indicator dot\">\n                </span>\n            </button>\n            <button class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-left hover:bg-white/5\" data-kid=\"1-2-5-3\" data-name=\"Thảo Hà DM conversation row\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#3c8790] text-[11px] font-bold text-white\" data-kid=\"1-2-5-3-1\" data-name=\"DM initials avatar\">\n                    TH\n                </span>\n                <span class=\"min-w-0 flex-1 truncate text-[14px] font-semibold text-[#b5bac1]\" data-kid=\"1-2-5-3-2\" data-name=\"DM user display name\">\n                    Thảo Hà\n                </span>\n            </button>\n            <button class=\"flex h-11 items-center gap-3 rounded-md px-2.5 text-left hover:bg-white/5\" data-kid=\"1-2-5-4\" data-name=\"weekend group DM row\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#8b5a51] text-[11px] font-bold text-white\" data-kid=\"1-2-5-4-1\" data-name=\"group initials avatar\">\n                    +3\n         