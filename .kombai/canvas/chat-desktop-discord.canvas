      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"h-[960px] w-[1440px] overflow-hidden bg-[#27292D] font-['Nunito_Sans',sans-serif] text-[#EAEBEE] antialiased\" data-kid=\"1\" data-name=\"app page layout container\">\n    <div class=\"flex h-full w-full\" data-kid=\"1-1\" data-name=\"three-column app shell\">\n        <nav aria-label=\"Điều hướng chính\" class=\"flex w-[72px] shrink-0 flex-col items-center gap-3 bg-[#151619] py-3\" data-kid=\"1-1-1\" data-name=\"left server navigation rail\">\n            <button aria-label=\"Tin nhắn\" class=\"group relative flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#5865F2] text-[22px] text-white\" data-kid=\"1-1-1-1\" data-name=\"active inbox server button\" title=\"Tin nhắn\">\n                <i class=\"ph ph-chat-circle-dots\" data-kid=\"1-1-1-1-1\" data-name=\"chat bubble icon\">\n                </i>\n                <span class=\"absolute -left-[13px] top-2 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-1-1-2\" data-name=\"active server indicator bar\">\n                </span>\n            </button>\n            <div class=\"h-px w-8 bg-[#35363A]\" data-kid=\"1-1-1-2\" data-name=\"navigation separator divider\">\n            </div>\n            <button aria-label=\"Cộng đồng bạn bè\" class=\"flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#25262A] text-[22px] text-[#B8BAC0]\" data-kid=\"1-1-1-3\" data-name=\"community friends server button\">\n                <i class=\"ph ph-users-three\" data-kid=\"1-1-1-3-1\" data-name=\"users group icon\">\n                </i>\n            </button>\n            <button aria-label=\"Thiết kế nhóm\" class=\"relative flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#34363D] text-[21px] text-white ring-2 ring-[#5865F2]\" data-kid=\"1-1-1-4\" data-name=\"group design server button\">\n                <span class=\"font-extrabold text-[13px] tracking-tight\" data-kid=\"1-1-1-4-1\" data-name=\"server name label text\">\n                    UX\n                </span>\n                <span class=\"absolute -left-[13px] top-2 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-1-4-2\" data-name=\"recently active server indicator bar\">\n                </span>\n            </button>\n            <button aria-label=\"Nhóm chơi\" class=\"flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#25262A] text-[22px] text-[#B8BAC0]\" data-kid=\"1-1-1-5\" data-name=\"gaming group server button\">\n                <i class=\"ph ph-game-controller\" data-kid=\"1-1-1-5-1\" data-name=\"game controller icon\">\n                </i>\n            </button>\n            <button aria-label=\"Thêm cộng đồng\" class=\"flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#25262A] text-[22px] text-[#43C07A]\" data-kid=\"1-1-1-6\" data-name=\"add community button\">\n                <i class=\"ph ph-plus\" data-kid=\"1-1-1-6-1\" data-name=\"plus icon\">\n                </i>\n            </button>\n            <div class=\"mt-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#C27B58] text-[13px] font-extrabold text-white\" data-kid=\"1-1-1-7\" data-name=\"user profile avatar with status\">\n                LA\n                <span class=\"absolute bottom-[67px] right-[14px] h-[11px] w-[11px] rounded-full border-2 border-[#151619] bg-[#43C07A]\" data-kid=\"1-1-1-7-1\" data-name=\"online status indicator dot\">\n                </span>\n            </div>\n        </nav>\n        <aside class=\"flex w-[240px] shrink-0 flex-col bg-[#1E1F23]\" data-kid=\"1-1-2\" data-name=\"channel sidebar panel\">\n            <button class=\"flex h-12 items-center justify-between border-b border-[#141517] px-4 text-left text-[15px] font-bold text-[#F2F3F5]\" data-kid=\"1-1-2-1\" data-name=\"channel selector header button\">\n                <span data-kid=\"1-1-2-1-1\" data-name=\"current channel name text\">\n                    Thiết kế nhóm\n                </span>\n                <i class=\"ph ph-caret-down text-[16px] text-[#A5A7AD]\" data-kid=\"1-1-2-1-2\" data-name=\"caret down dropdown icon\">\n                </i>\n            </button>\n            <div class=\"px-2 pt-3\" data-kid=\"1-1-2-2\" data-name=\"inbox shortcut wrapper\">\n                <button class=\"flex h-9 w-full items-center gap-3 rounded-md bg-[#35373D] px-2.5 text-[14px] font-semibold text-white\" data-kid=\"1-1-2-2-1\" data-name=\"inbox shortcut button\">\n                    <i class=\"ph ph-envelope-simple-open text-[19px] text-[#C9CBD0]\" data-kid=\"1-1-2-2-1-1\" data-name=\"inbox envelope icon\">\n                    </i>\n                    Hộp thư\n                    <span class=\"ml-auto rounded-full bg-[#5865F2] px-1.5 py-0.5 text-[11px] font-extrabold leading-none text-white\" data-kid=\"1-1-2-2-1-2\" data-name=\"inbox unread count badge\">\n                        3\n                    </span>\n                </button>\n            </div>\n            <div class=\"mt-5 px-4 text-[11px] font-extrabold uppercase tracking-[0.08em] text-[#9699A1]\" data-kid=\"1-1-2-3\" data-name=\"text channels section label\">\n                Kênh văn bản\n            </div>\n            <div class=\"mt-2 space-y-0.5 px-2\" data-kid=\"1-1-2-4\" data-name=\"text channels list container\">\n                <div class=\"flex h-9 items-center gap-2 rounded-md px-2.5 text-[14px] text-[#AEB0B6]\" data-kid=\"1-1-2-4-1\" data-name=\"common channel item\">\n                    <i class=\"ph ph-hash text-[18px]\" data-kid=\"1-1-2-4-1-1\" data-name=\"channel hash icon\">\n                    </i>\n                    chung\n                </div>\n                <div class=\"flex h-9 items-center gap-2 rounded-md bg-[#3B3D44] px-2.5 text-[14px] font-semibold text-white\" data-kid=\"1-1-2-4-2\" data-name=\"active Q&A channel item\">\n                    <i class=\"ph ph-hash text-[18px] text-[#C8CAD0]\" data-kid=\"1-1-2-4-2-1\" data-name=\"channel hash icon\">\n                    </i>\n                    hỏi-đáp\n                    <span class=\"ml-auto h-2 w-2 rounded-full bg-[#5865F2]\" data-kid=\"1-1-2-4-2-2\" data-name=\"channel mention indicator dot\">\n                    </span>\n                </div>\n                <div class=\"flex h-9 items-center gap-2 rounded-md px-2.5 text-[14px] text-[#AEB0B6]\" data-kid=\"1-1-2-4-3\" data-name=\"sharing channel item\">\n                    <i class=\"ph ph-hash text-[18px]\" data-kid=\"1-1-2-4-3-1\" data-name=\"channel hash icon\">\n                    </i>\n                    chia-sẻ\n                </div>\n            </div>\n            <div class=\"mt-5 px-4 text-[11px] font-extrabold uppercase tracking-[0.08em] text-[#9699A1]\" data-kid=\"1-1-2-5\" data-name=\"voice channels section label\">\n                Kênh gặp\n            </div>\n            <div class=\"mt-2 space-y-0.5 px-2\" data-kid=\"1-1-2-6\" data-name=\"voice channels list container\">\n                <div class=\"flex h-9 items-center gap-2 rounded-md px-2.5 text-[14px] text-[#AEB0B6]\" data-kid=\"1-1-2-6-1\" data-name=\"voice channel item\">\n                    <i class=\"ph ph-speaker-high text-[18px]\" data-kid=\"1-1-2-6-1-1\" data-name=\"voice speaker icon\">\n                    </i>\n                    Phòng làm việc\n                </div>\n            </div>\n            <div class=\"mt-auto flex items-center gap-2.5 border-t border-[#151619] px-3 py-3\" data-kid=\"1-1-2-7\" data-name=\"sidebar user footer bar\">\n                <div class=\"relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C27B58] text-[11px] font-extrabold text-white\" data-kid=\"1-1-2-7-1\" data-name=\"user profile avatar with status\">\n                    LA\n                    <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-2 border-[#1E1F23] bg-[#43C07A]\" data-kid=\"1-1-2-7-1-1\" data-name=\"online status indicator dot\">\n                    </span>\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-7-2\" data-name=\"user info block\">\n                    <div class=\"truncate text-[13px] font-bold text-[#F2F3F5]\" data-kid=\"1-1-2-7-2-1\" data-name=\"user display name text\">\n                        Lan Anh\n                    </div>\n                    <div class=\"text-[11px] text-[#A4A6AD]\" data-kid=\"1-1-2-7-2-2\" data-name=\"user online status text\">\n                        Đang trực tuyến\n                    </div>\n                </div>\n                <button aria-label=\"Cài đặt người dùng\" class=\"text-[19px] text-[#AEB0B6]\" data-kid=\"1-1-2-7-3\" data-name=\"user settings gear button\">\n                    <i class=\"ph ph-gear-six\" data-kid=\"1-1-2-7-3-1\" data-name=\"gear settings icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <main class=\"flex min-w-0 flex-1 flex-col bg-[#27292D]\" data-kid=\"1-1-3\" data-name=\"main channel content panel\">\n            <header class=\"flex h-12 shrink-0 items-center justify-between border-b border-[#202125] px-4\" data-kid=\"1-1-3-1\" data-name=\"channel header bar\">\n                <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-3-1-1\" data-name=\"channel identity group\">\n                    <i class=\"ph ph-hash text-[21px] text-[#A8AAB1]\" data-kid=\"1-1-3-1-1-1\" data-name=\"channel hash icon\">\n                    </i>\n                    <span class=\"text-[15px] font-bold text-[#F2F3F5]\" data-kid=\"1-1-3-1-1-2\" data-name=\"channel name text\">\n                        hỏi-đáp\n                    </span>\n                    <span class=\"h-5 w-px bg-[#414248]\" data-kid=\"1-1-3-1-1-3\" data-name=\"channel header divider\">\n                    </span>\n                    <span class=\"truncate text-[12px] text-[#AEB0B6]\" data-kid=\"1-1-3-1-1-4\" data-name=\"channel topic description text\">\n                        Trao đổi nhanh, cùng tìm lời giải\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4 text-[20px] text-[#B6B8BE]\" data-kid=\"1-1-3-1-2\" data-name=\"channel action icons group\">\n                    <button aria-label=\"Tìm trong hội thoại\" data-kid=\"1-1-3-1-2-1\" data-name=\"search in conversation button\">\n                        <i class=\"ph ph-magnifying-glass\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"magnifying glass icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Thành viên\" data-kid=\"1-1-3-1-2-2\" data-name=\"channel members button\">\n                        <i class=\"ph ph-users-three\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"users group icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Ghim tin nhắn\" data-kid=\"1-1-3-1-2-3\" data-name=\"pin messages button\">\n                        <i class=\"ph ph-push-pin\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"push pin icon\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <div class=\"flex items-center gap-2 border-b border-[#202125] bg-[#282A2F] px-5 py-2 text-[12px] text-[#B6B8BE]\" data-kid=\"1-1-3-2\" data-name=\"context breadcrumb bar\">\n                <i class=\"ph ph-arrow-u-up-left text-[16px] text-[#A5A7AD]\" data-kid=\"1-1-3-2-1\" data-name=\"back arrow icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"breadcrumb source text\">\n                    Đang mở tin nhắn từ\n                    <strong class=\"font-semibold text-[#D9DADE]\" data-kid=\"1-1-3-2-2-1\" data-name=\"inbox name reference text\">\n                        Hộp thư\n                    </strong>\n                </span>\n                <span class=\"text-[#747780]\" data-kid=\"1-1-3-2-3\" data-name=\"breadcrumb separator text\">\n                    ·\n                </span>\n                <span data-kid=\"1-1-3-2-4\" data-name=\"breadcrumb channel reference text\">\n                    #hỏi-đáp\n                </span>\n            </div>\n            <section aria-label=\"Nội dung kênh hỏi đáp\" class=\"flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-3-3\" data-name=\"channel message section\">\n                <div class=\"flex-1 overflow-hidden px-5 pt-4\" data-kid=\"1-1-3-3-1\" data-name=\"message list container\">\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-3-3-1-1\" data-name=\"incoming message header section\">\n                        <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#4D7893] text-[13px] font-extrabold text-white\" data-kid=\"1-1-3-3-1-1-1\" data-name=\"sender avatar initials\">\n                            HM\n                        </span>\n                        <div data-kid=\"1-1-3-3-1-1-2\" data-name=\"sender info block\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-3-1-1-2-1\" data-name=\"sender name and badge row\">\n                                <span class=\"text-[14px] font-bold text-[#F2F3F5]\" data-kid=\"1-1-3-3-1-1-2-1-1\" data-name=\"sender display name text\">\n                                    Hà My\n                                </span>\n                                <span class=\"rounded bg-[#3F4265] px-1.5 py-0.5 text-[10px] font-bold text-[#C8CBFF]\" data-kid=\"1-1-3-3-1-1-2-1-2\" data-name=\"sender role badge\">\n                                    Nhóm UX\n                                </span>\n                            </div>\n                            <p class=\"mt-0.5 text-[11px] text-[#9B9EA6]\" data-kid=\"1-1-3-3-1-1-2-2\" data-name=\"message context caption\">\n                                Tin nhắn trong\n                                <span class=\"text-[#C5C7CD]\" data-kid=\"1-1-3-3-1-1-2-2-1\" data-name=\"channel name reference in caption\">\n                                    #hỏi-đáp\n                                </span>\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"ml-[52px] max-w-[600px] rounded-md border-l-2 border-[#5865F2] bg-[#303239] px-3.5 py-3 shadow-[0_1px_0_rgba(0,0,0,0.12)]\" data-kid=\"1-1-3-3-1-2\" data-name=\"quoted original message card\">\n                        <div class=\"mb-1 flex items-center gap-2 text-[11px] text-[#AEB0B6]\" data-kid=\"1-1-3-3-1-2-1\" data-name=\"message card meta row\">\n                            <i class=\"ph ph-envelope-open text-[14px] text-[#8992FF]\" data-kid=\"1-1-3-3-1-2-1-1\" data-name=\"envelope open icon\">\n                            </i>\n                            Đã mở từ thông báo\n                            <span class=\"text-[#70737C]\" data-kid=\"1-1-3-3-1-2-1-2\" data-name=\"meta separator dot\">\n                                ·\n                            </span>\n                            tin được đánh dấu\n                        </div>\n                        <p class=\"text-[14px] leading-[1.55] text-[#E5E6E9]\" data-kid=\"1-1-3-3-1-2-2\" data-name=\"quoted message body text\">\n                            @Lan Anh ơi, xem giúp mình flow đăng nhập với nhé. Mình vừa cập nhật màn hình và muốn xin góp ý trước khi chốt.\n                        </p>\n                    </div>\n                    <div class=\"ml-[52px] mt-2.5 text-[13px] text-[#B9BBC1]\" data-kid=\"1-1-3-3-1-3\" data-name=\"follow-up message text\">\n                        Phần đăng ký mình đã rút gọn còn hai bước rồi.\n                    </div>\n                    <div class=\"ml-[52px] mt-2 flex items-center gap-1.5\" data-kid=\"1-1-3-3-1-4\" data-name=\"message reaction bar\">\n                        <span c