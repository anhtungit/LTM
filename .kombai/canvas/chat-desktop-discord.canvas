te-pulse rounded-full bg-[#aeb1b8]\" data-kid=\"1-1-3-2-1-1-6-3-3\" data-name=\"animated typing dot\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"shrink-0 px-6 pb-5 pt-2\" data-kid=\"1-1-3-2-1-2\" data-name=\"message composer section\">\n                        <div class=\"rounded-lg bg-[#313338] px-3.5 pb-3 pt-3\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"composer card with pending attachment\">\n                            <div class=\"mb-3 flex items-center gap-3 rounded-md bg-[#282a2f] px-3 py-2.5\" data-kid=\"1-1-3-2-1-2-1-1\" data-name=\"attached file preview row\">\n                                <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#3a3033] text-[20px] text-[#f08a8d]\" data-kid=\"1-1-3-2-1-2-1-1-1\" data-name=\"file type icon box\">\n                                    <i class=\"ph ph-file-png\" data-kid=\"1-1-3-2-1-2-1-1-1-1\" data-name=\"PNG file icon\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-2-1-2-1-1-2\" data-name=\"file details container\">\n                                    <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-1-3-2-1-2-1-1-2-1\" data-name=\"file name row\">\n                                        <span class=\"truncate text-[12px] font-bold text-[#e4e5e8]\" data-kid=\"1-1-3-2-1-2-1-1-2-1-1\" data-name=\"file name text\">\n                                            architecture-chat-flow-v2.png\n                                        </span>\n                                        <span class=\"shrink-0 rounded bg-[#3c3e44] px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-[#afb1b6]\" data-kid=\"1-1-3-2-1-2-1-1-2-1-2\" data-name=\"file type sample badge\">\n                                            Mẫu\n                    