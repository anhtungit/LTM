t-extrabold text-[#152131]\" data-kid=\"1-1-4-4-4-1\">\n                        AN\n                    </div>\n                    <span class=\"text-[11px] text-[#D1D2D7]\" data-kid=\"1-1-4-4-4-2\">\n                        An Nguyễn\n                    </span>\n                </div>\n            </div>\n            <button class=\"mt-5 flex h-[34px] items-center justify-center gap-2 rounded-md bg-[#3B3D44] text-[11px] font-bold text-[#EBECF0]\" data-kid=\"1-1-4-5\">\n                <i class=\"ph ph-user-circle text-[15px]\" data-kid=\"1-1-4-5-1\">\n                </i>\n                Xem hồ sơ\n            </button>\n            <div class=\"mt-auto mb-4 rounded-md border border-[#34363B] px-2.5 py-2 text-[10px] leading-[1.45] text-[#898C94]\" data-kid=\"1-1-4-6\">\n                <i class=\"ph ph-lock-key mr-1 text-[12px]\" data-kid=\"1-1-4-6-1\">\n                </i>\n                Dữ liệu minh họa · kết nối backend chưa có.\n            </div>\n        </aside>\n    </div>\n</div>\n",
