      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"h-screen min-h-[900px] w-full overflow-hidden bg-[#27292d] font-['Nunito_Sans',sans-serif] text-[#eaebee]\" data-kid=\"1\" data-name=\"Discord-style chat app page container\">\n    <div class=\"flex h-full min-w-[1120px]\" data-kid=\"1-1\" data-name=\"app three-column layout row\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-2 bg-[#151619] py-3\" data-kid=\"1-1-1\" data-name=\"server rail\">\n            <button aria-label=\"Discord\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#5e68f7] text-[25px] text-white shadow-sm\" data-kid=\"1-1-1-1\" data-name=\"Discord logo entry button\">\n                <i class=\"ph ph-discord-logo\" data-kid=\"1-1-1-1-1\" data-name=\"Discord logo icon\">\n                </i>\n            </button>\n            <div class=\"my-1 h-px w-8 bg-[#37383d]\" data-kid=\"1-1-1-2\" data-name=\"server rail divider\">\n            </div>\n            <button aria-label=\"LTM Study\" class=\"relative flex h-12 w-12 items-center justify-center rounded-2xl bg-[#34363d] text-[15px] font-extrabold text-[#e5e7eb]\" data-kid=\"1-1-1-3\" data-name=\"active server button (LTM Study)\">\n                <span class=\"absolute -left-3 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-1-3-1\" data-name=\"active server left indicator bar\">\n                </span>\n                LS\n            </button>\n            <button aria-label=\"Bạn bè\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2a2c31] text-[21px] text-[#aeb1b8]\" data-kid=\"1-1-1-4\" data-name=\"server friends placeholder button\">\n                <i class=\"ph ph-users-three\" data-kid=\"1-1-1-4-1\" data-name=\"three users icon\">\n                </i>\n            </button>\n            <button aria-label=\"Thêm máy chủ\" class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2a2c31] text-[23px] text-[#43c07a]\" data-kid=\"1-1-1-5\" data-name=\"add server button\">\n                <i class=\"ph ph-plus\" data-kid=\"1-1-1-5-1\" data-name=\"plus icon\">\n                </i>\n            </button>\n        </aside>\n        <aside class=\"flex w-[240px] shrink-0 flex-col bg-[#1e1f23] text-[#afb1b6]\" data-kid=\"1-1-2\" data-name=\"channel sidebar\">\n            <div class=\"flex h-12 shrink-0 items-center justify-between border-b border-[#191a1e] px-4 text-[15px] font-bold text-[#eaebee]\" data-kid=\"1-1-2-1\" data-name=\"server name header bar\">\n                <span data-kid=\"1-1-2-1-1\" data-name=\"server name title\">\n                    LTM Study\n                </span>\n                <i class=\"ph ph-caret-down text-[15px]\" data-kid=\"1-1-2-1-2\" data-name=\"caret down icon\">\n                </i>\n            </div>\n            <div class=\"px-3 pt-3\" data-kid=\"1-1-2-2\" data-name=\"sidebar search and inbox section\">\n                <div class=\"flex h-8 items-center gap-2 rounded-md bg-[#151619] px-2.5 text-[12px] text-[#888b92]\" data-kid=\"1-1-2-2-1\" data-name=\"channel search input field\">\n                    <i class=\"ph ph-magnifying-glass text-[14px]\" data-kid=\"1-1-2-2-1-1\" data-name=\"magnifying glass icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-1-2\" data-name=\"search placeholder label\">\n                        Tìm kiếm\n                    </span>\n                    <span class=\"ml-auto text-[10px]\" data-kid=\"1-1-2-2-1-3\" data-name=\"keyboard shortcut hint (Ctrl K)\">\n                        Ctrl K\n                    </span>\n                </div>\n                <button class=\"mt-3 flex h-9 w-full items-center gap-2 rounded-md px-2 text-[14px] font-semibold text-[#c9cbd0] hover:bg-[#2b2d32]\" data-kid=\"1-1-2-2-2\" data-name=\"inbox channel button\">\n                    <i class=\"ph ph-inbox text-[18px]\" data-kid=\"1-1-2-2-2-1\" data-name=\"inbox icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-2-2\" data-name=\"inbox label text\">\n                        Hộp thư\n                    </span>\n                    <span class=\"ml-auto rounded-full bg-[#5e68f7] px-1.5 py-0.5 text-[10px] font-bold text-white\" data-kid=\"1-1-2-2-2-3\" data-name=\"inbox unread badge with count\">\n                        2\n                    </span>\n                </button>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between px-4 text-[11px] font-extrabold tracking-wide text-[#8b8e96]\" data-kid=\"1-1-2-3\" data-name=\"text channels section header\">\n                <span data-kid=\"1-1-2-3-1\" data-name=\"section title (KÊNH VĂN BẢN)\">\n                    KÊNH VĂN BẢN\n                </span>\n                <i class=\"ph ph-plus text-[14px]\" data-kid=\"1-1-2-3-2\" data-name=\"add channel plus icon\">\n                </i>\n            </div>\n            <div class=\"mt-1 flex flex-col gap-0.5 px-2\" data-kid=\"1-1-2-4\" data-name=\"text channels list\">\n                <div class=\"flex h-8 items-center gap-2 rounded-md px-2.5 text-[13px]\" data-kid=\"1-1-2-4-1\" data-name=\"#chung channel row\">\n                    <i class=\"ph ph-hash text-[17px]\" data-kid=\"1-1-2-4-1-1\" data-name=\"hash channel icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-4-1-2\" data-name=\"channel name text\">\n                        chung\n                    </span>\n                </div>\n                <div class=\"flex h-8 items-center gap-2 rounded-md bg-[#3b3d44] px-2.5 text-[13px] font-semibold text-white\" data-kid=\"1-1-2-4-2\" data-name=\"#team-chat selected channel row\">\n                    <i class=\"ph ph-hash text-[17px]\" data-kid=\"1-1-2-4-2-1\" data-name=\"hash channel icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-4-2-2\" data-name=\"channel name text\">\n                        team-chat\n                    </span>\n                    <span class=\"ml-auto h-1.5 w-1.5 rounded-full bg-[#f0bb3b]\" data-kid=\"1-1-2-4-2-3\" data-name=\"mention indicator dot\">\n                    </span>\n                </div>\n                <div class=\"flex h-8 items-center gap-2 rounded-md px-2.5 text-[13px]\" data-kid=\"1-1-2-4-3\" data-name=\"#tài-liệu channel row\">\n                    <i class=\"ph ph-hash text-[17px]\" data-kid=\"1-1-2-4-3-1\" data-name=\"hash channel icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-4-3-2\" data-name=\"channel name text\">\n                        tài-liệu\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between px-4 text-[11px] font-extrabold tracking-wide text-[#8b8e96]\" data-kid=\"1-1-2-5\" data-name=\"voice channels section header\">\n                <span data-kid=\"1-1-2-5-1\" data-name=\"section title (KÊNH GẶP)\">\n                    KÊNH GẶP\n                </span>\n                <i class=\"ph ph-plus text-[14px]\" data-kid=\"1-1-2-5-2\" data-name=\"add channel plus icon\">\n                </i>\n            </div>\n            <div class=\"mt-1 flex h-8 items-center gap-2 px-4 text-[13px]\" data-kid=\"1-1-2-6\" data-name=\"voice channel row\">\n                <i class=\"ph ph-speaker-high text-[17px]\" data-kid=\"1-1-2-6-1\" data-name=\"speaker icon\">\n                </i>\n                <span data-kid=\"1-1-2-6-2\" data-name=\"voice channel name text\">\n                    Phòng nhóm\n                </span>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between px-4 text-[11px] font-extrabold tracking-wide text-[#8b8e96]\" data-kid=\"1-1-2-7\" data-name=\"games section header\">\n                <span data-kid=\"1-1-2-7-1\" data-name=\"section title (TRÒ CHƠI)\">\n                    TRÒ CHƠI\n                </span>\n            </div>\n            <div class=\"mt-1 flex h-8 items-center gap-2 px-4 text-[12px] text-[#777a82]\" data-kid=\"1-1-2-8\" data-name=\"games placeholder row\">\n                <i class=\"ph ph-game-controller text-[17px]\" data-kid=\"1-1-2-8-1\" data-name=\"game controller icon\">\n                </i>\n                <span data-kid=\"1-1-2-8-2\" data-name=\"games unavailable caption\">\n                    Chưa tích hợp\n                </span>\n            </div>\n            <div class=\"mt-auto border-t border-[#191a1e] px-2 pt-2\" data-kid=\"1-1-2-9\" data-name=\"sidebar user footer\">\n                <div class=\"mb-2 flex items-center gap-2 rounded-md bg-[#282a2f] px-2.5 py-2\" data-kid=\"1-1-2-9-1\" data-name=\"disconnected status banner\">\n                    <span class=\"relative flex h-2 w-2 shrink-0\" data-kid=\"1-1-2-9-1-1\" data-name=\"status dot container\">\n                        <span class=\"absolute inline-flex h-full w-full rounded-full bg-[#f54748]\" data-kid=\"1-1-2-9-1-1-1\" data-name=\"red offline indicator dot\">\n                        </span>\n                    </span>\n                    <span class=\"text-[11px] font-semibold text-[#ffb4b4]\" data-kid=\"1-1-2-9-1-2\" data-name=\"disconnected status label\">\n                        Đã ngắt kết nối\n                    </span>\n                    <i class=\"ph ph-warning-circle ml-auto text-[15px] text-[#f54748]\" data-kid=\"1-1-2-9-1-3\" data-name=\"warning circle icon\">\n                    </i>\n                </div>\n                <div class=\"flex h-12 items-center gap-2 rounded-md px-1.5\" data-kid=\"1-1-2-9-2\" data-name=\"user card row\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#6c738d] text-[11px] font-bold text-white\" data-kid=\"1-1-2-9-2-1\" data-name=\"user avatar with initials\">\n                        AN\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-9-2-2\" data-name=\"user info container\">\n                        <div class=\"truncate text-[12px] font-bold text-[#eaebee]\" data-kid=\"1-1-2-9-2-2-1\" data-name=\"selected user display name\">\n                            An Nguyen\n                        </div>\n                        <div class=\"text-[10px] text-[#888b92]\" data-kid=\"1-1-2-9-2-2-2\" data-name=\"user substatus text\">\n                            Đang trực tuyến · mẫu\n                        </div>\n                    </div>\n                    <i class=\"ph ph-microphone-slash text-[16px] text-[#afb1b6]\" data-kid=\"1-1-2-9-2-3\" data-name=\"muted microphone icon\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"flex min-w-0 flex-1 flex-col bg-[#27292d]\" data-kid=\"1-1-3\" data-name=\"main chat area\">\n            <header class=\"flex h-12 shrink-0 items-center justify-between border-b border-[#222428] px-4\" data-kid=\"1-1-3-1\" data-name=\"channel top header bar\">\n                <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-3-1-1\" data-name=\"channel title group\">\n                    <i class=\"ph ph-hash text-[22px] text-[#868991]\" data-kid=\"1-1-3-1-1-1\" data-name=\"hash channel icon\">\n                    </i>\n                    <span class=\"text-[15px] font-bold text-[#f0f1f3]\" data-kid=\"1-1-3-1-1-2\" data-name=\"channel name title\">\n                        team-chat\n                    </span>\n                    <span class=\"h-5 w-px bg-[#3a3c42]\" data-kid=\"1-1-3-1-1-3\" data-name=\"vertical divider\">\n                    </span>\n                    <span class=\"truncate text-[12px] text-[#9699a1]\" data-kid=\"1-1-3-1-1-4\" data-name=\"channel topic text\">\n                        Trao đổi công việc và tài liệu nhóm\n                    </span>\n                </div>\n                <div class=\"ml-3 flex shrink-0 items-center gap-4 text-[19px] text-[#b7b9bf]\" data-kid=\"1-1-3-1-2\" data-name=\"header right action buttons cluster\">\n                    <button aria-label=\"Bắt đầu cuộc gọi\" data-kid=\"1-1-3-1-2-1\" data-name=\"start voice call button\">\n                        <i class=\"ph ph-phone\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"phone icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Thông báo\" data-kid=\"1-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ph ph-bell\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"bell icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Tìm kiếm\" data-kid=\"1-1-3-1-2-3\" data-name=\"search button\">\n                        <i class=\"ph ph-magnifying-glass\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"magnifying glass icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Danh sách thành viên\" class=\"text-white\" data-kid=\"1-1-3-1-2-4\" data-name=\"member list toggle button\">\n                        <i class=\"ph ph-users-three\" data-kid=\"1-1-3-1-2-4-1\" data-name=\"three users icon\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <section class=\"flex min-h-0 flex-1\" data-kid=\"1-1-3-2\" data-name=\"chat plus members layout row\">\n                <div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-1-3-2-1\" data-name=\"chat messages column\">\n                    <div class=\"flex-1 overflow-y-auto px-6 pb-5 pt-7\" data-kid=\"1-1-3-2-1-1\" data-name=\"scrollable messages container\">\n                        <div class=\"mb-6 flex items-center gap-3\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"channel welcome banner\">\n                            <div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#3b3d44] text-[24px] text-[#c9cbd0]\" data-kid=\"1-1-3-2-1-1-1-1\" data-name=\"channel avatar with hash icon\">\n                                <i class=\"ph ph-hash\" data-kid=\"1-1-3-2-1-1-1-1-1\" data-name=\"channel hash icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-1-3-2-1-1-1-2\" data-name=\"channel welcome text block\">\n                                <div class=\"text-[24px] font-extrabold leading-8 text-white\" data-kid=\"1-1-3-2-1-1-1-2-1\" data-name=\"welcome headline\">\n                                    Chào mừng đến với #team-chat\n                                </div>\n                                <div class=\"mt-0.5 text-[13px] text-[#aeb1b8]\" data-kid=\"1-1-3-2-1-1-1-2-2\" data-name=\"welcome subtitle\">\n                                    Đây là nơi bắt đầu cuộc trò chuyện của nhóm.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"date divider row\">\n                            <div class=\"h-px flex-1 bg-[#3c3e44]\" data-kid=\"1-1-3-2-1-1-2-1\" data-name=\"left divider line\">\n                            </div>\n                            <span class=\"text-[10px] font-bold uppercase tracking-wide text-[#8b8e96]\" data-kid=\"1-1-3-2-1-1-2-2\" data-name=\"date divider label\">\n                                Tin nhắn hôm nay · nội dung mẫu\n                            </span>\n                            <div class=\"h-px flex-1 bg-[#3c3e44]\" data-kid=\"1-1-3-2-1-1-2-3\" data-name=\"right divider line\">\n                            </div>\n                        </div>\n                        <div class=\"group flex gap-4 py-2.5\" data-kid=\"1-1-3-2-1-1-3\" data-name=\"chat message row (Minh Anh)\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#d2846d] text-[12px] font-extrabold text-[#242528]\" data-kid=\"1-1-3-2-1-1-3-1\" data-name=\"author avatar with initials\">\n                                MA\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-1-3-2-1-1-3-2\" data-name=\"message content wrapper\">\n                                <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-3-2-1-1-3-2-1\" data-name=\"author name and time row\">\n                                    <span class=\"text-[14px] font-bold text-[#f1b56f]\" data-kid=\"1-1-3-2-1-1-3-2-1-1\" data-name=\"author display name\">\n                                        Minh Anh\n                                    </span>\n                                    <span class=\"text-[10px] text-[#82858d]\" data-kid=\"1-1-3-2-1-1-3-2-1-2\" data-name=\"message timestamp\">\n                                        10:12\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[14px] leading-[1.55] text-[#dcdee2]\" data-kid=\"1-1-3-2-1-1-3-2-2\" data-name=\"message body text\">\n                                    Mình đã cập nhật luồng chat nhóm rồi nhé, mọi người xem qua giúp mình.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"group flex gap-4 py-2.5\" data-kid=\"1-1-3-2-1-1-4\" data-name=\"chat message row (Tuấn Quân)\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#60918d] text-[12px] font-extrabold text-[#171a1b]\" data-kid=\"1-1-3-2-1-1-4-1\" data-name=\"author avatar with initials\">\n                                TQ\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-1-3-2-1-1-4-2\" data-name=\"message content wrapper\">\n                                <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-3-2-1-1-4-2-1\" data-name=\"author name and time row\">\n                                    <span class=\"text-[14px] font-bold text-[#71c5b8]\" data-kid=\"1-1-3-2-1-1-4-2-1-1\" data-name=\"author display name\">\n                                        Tuấn Quân\n                                    </span>\n                                    <span class=\"text-[10px] text-[#82858d]\" data-kid=\"1-1-3-2-1-1-4-2-1-2\" data-name=\"message timestamp\">\n                                        10:15\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[14px] leading-[1.55] text-[#dcdee2]\" data-kid=\"1-1-3-2-1-1-4-2-2\" data-name=\"message first line\">\n                                    Phần reconnect đang được kiểm tra thêm ở server TCP.\n                                </p>\n                                <p class=\"text-[14px] leading-[1.55] text-[#dcdee2]\" data-kid=\"1-1-3-2-1-1-4-2-3\" data-name=\"message second line\">\n                                    Nếu mất kết nối, bản nháp và tệp đính kèm vẫn cần được giữ lại.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"group flex gap-4 py-2.5\" data-kid=\"1-1-3-2-1-1-5\" data-name=\"chat message row (Linh Hoàng)\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#8b7fb1] text-[12px] font-extrabold text-[#1b1a21]\" data-kid=\"1-1-3-2-1-1-5-1\" data-name=\"author avatar with initials\">\n                                LH\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-1-3-2-1-1-5-2\" data-name=\"message content wrapper\">\n                                <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-3-2-1-1-5-2-1\" data-name=\"author name and time row\">\n                 