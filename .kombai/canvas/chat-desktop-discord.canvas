      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\nbody { background-color: #27292D; }\n</style>\n<div class=\"flex h-[900px] min-h-[900px] w-full overflow-hidden bg-[#27292D] font-[Nunito_Sans,system-ui,sans-serif] text-[#EAEBEE]\" data-kid=\"1\" data-name=\"Discord-style community layout container\">\n    <!-- Discord-style community rail -->\n    <aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-3 bg-[#151619] px-3 py-4\" data-kid=\"1-1\" data-name=\"Discord-style server rail\">\n        <div aria-label=\"Trang chủ\" class=\"flex h-12 w-12 items-center justify-center rounded-[18px] bg-[#5865F2] text-white\" data-kid=\"1-1-1\" data-name=\"home server tile\">\n            <span class=\"text-[22px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"server initial letter D\">\n                D\n            </span>\n        </div>\n        <div class=\"my-1 h-px w-8 bg-[#34363B]\" data-kid=\"1-1-2\" data-name=\"vertical divider line\">\n        </div>\n        <button aria-label=\"Nhóm học tập đang chọn\" class=\"relative flex h-12 w-12 items-center justify-center rounded-[18px] bg-[#3B3D44] text-white\" data-kid=\"1-1-3\" data-name=\"selected study group server tile\">\n            <span class=\"text-[15px] font-bold\" data-kid=\"1-1-3-1\" data-name=\"study group initial HT\">\n                HT\n            </span>\n            <span class=\"absolute -left-3 h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-3-2\" data-name=\"active server selection indicator bar\">\n            </span>\n        </button>\n        <button aria-label=\"Cộng đồng thiết kế\" class=\"flex h-12 w-12 items-center justify-center rounded-[18px] bg-[#24262A] text-[15px] font-bold text-[#B9BAC0]\" data-kid=\"1-1-4\" data-name=\"design community server tile\">\n            TK\n        </button>\n        <button aria-label=\"Thêm cộng đồng\" class=\"flex h-12 w-12 items-center justify-center rounded-[18px] bg-[#24262A] text-[#B9BAC0]\" data-kid=\"1-1-5\" data-name=\"add community button\">\n            <i class=\"ph ph-plus text-[22px]\" data-kid=\"1-1-5-1\" data-name=\"plus iconfalse\">\n            </i>\n        </button>\n        <div class=\"mt-auto flex h-11 w-11 items-center justify-center rounded-full bg-[#5865F2] text-[14px] font-bold text-white\" data-kid=\"1-1-6\" data-name=\"user avatar tile false\">\n            HN\n        </div>\n    </aside>\n    <!-- Conversation / channel sidebar -->\n    <aside class=\"flex w-[240px] shrink-0 flex-col bg-[#1E1F23]\" data-kid=\"1-2\" data-name=\"channel and members sidebar\">\n        <div class=\"flex h-12 items-center justify-between border-b border-[#17181B] px-4 shadow-sm\" data-kid=\"1-2-1\" data-name=\"community header bar\">\n            <span class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-1-1\" data-name=\"community name title\">\n                Nhóm học tập\n            </span>\n            <i class=\"ph ph-caret-down text-[16px] text-[#B9BAC0]\" data-kid=\"1-2-1-2\" data-name=\"caret dropdown icon\">\n            </i>\n        </div>\n        <div class=\"px-2 pt-3\" data-kid=\"1-2-2\" data-name=\"channel navigation panel\">\n            <button class=\"flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-[14px] font-semibold text-[#E4E5E8] hover:bg-[#34363B]\" data-kid=\"1-2-2-1\" data-name=\"inbox navigation item\">\n                <i class=\"ph ph-inbox text-[18px] text-[#B9BAC0]\" data-kid=\"1-2-2-1-1\" data-name=\"inbox icon\">\n                </i>\n                Hộp thư\n            </button>\n            <div class=\"mt-3 flex items-center justify-between px-2.5 pb-1.5 text-[11px] font-bold tracking-wide text-[#94969C]\" data-kid=\"1-2-2-2\" data-name=\"DM section header\">\n                <span data-kid=\"1-2-2-2-1\" data-name=\"DM section label\">\n                    TIN NHẮN\n                </span>\n                <i class=\"ph ph-plus text-[15px]\" data-kid=\"1-2-2-2-2\" data-name=\"add DM plus icon\">\n                </i>\n            </div>\n            <div class=\"space-y-0.5\" data-kid=\"1-2-2-3\" data-name=\"DM list container\">\n                <div class=\"flex items-center gap-2 rounded-md px-2.5 py-2 text-[14px] text-[#B9BAC0]\" data-kid=\"1-2-2-3-1\" data-name=\"DM entry Minh An\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#5865F2] text-[10px] font-bold text-white\" data-kid=\"1-2-2-3-1-1\" data-name=\"DM avatar initial\">\n                        MA\n                    </span>\n                    <span class=\"truncate\" data-kid=\"1-2-2-3-1-2\" data-name=\"DM user name\">\n                        Minh An\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-md px-2.5 py-2 text-[14px] text-[#B9BAC0]\" data-kid=\"1-2-2-3-2\" data-name=\"DM entry Linh Trần\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#A98170] text-[10px] font-bold text-white\" data-kid=\"1-2-2-3-2-1\" data-name=\"DM avatar initial\">\n                        LT\n                    </span>\n                    <span class=\"truncate\" data-kid=\"1-2-2-3-2-2\" data-name=\"DM user name\">\n                        Linh Trần\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between px-2.5 pb-1.5 text-[11px] font-bold tracking-wide text-[#94969C]\" data-kid=\"1-2-2-4\" data-name=\"text channel section header\">\n                <span data-kid=\"1-2-2-4-1\" data-name=\"text channel section label\">\n                    KÊNH VĂN BẢN\n                </span>\n                <i class=\"ph ph-plus text-[15px]\" data-kid=\"1-2-2-4-2\" data-name=\"add channel plus icon\">\n                </i>\n            </div>\n            <div class=\"space-y-0.5\" data-kid=\"1-2-2-5\" data-name=\"text channel list container\">\n                <div class=\"flex items-center gap-2 rounded-md px-2.5 py-2 text-[14px] text-[#B9BAC0]\" data-kid=\"1-2-2-5-1\" data-name=\"text channel item chung\">\n                    <i class=\"ph ph-hash text-[17px] text-[#777980]\" data-kid=\"1-2-2-5-1-1\" data-name=\"channel hash icon\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"1-2-2-5-1-2\" data-name=\"channel name\">\n                        chung\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-md px-2.5 py-2 text-[14px] text-[#B9BAC0]\" data-kid=\"1-2-2-5-2\" data-name=\"text channel item tài-liệu\">\n                    <i class=\"ph ph-hash text-[17px] text-[#777980]\" data-kid=\"1-2-2-5-2-1\" data-name=\"channel hash icon\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"1-2-2-5-2-2\" data-name=\"channel name\">\n                        tài-liệu\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between px-2.5 pb-1.5 text-[11px] font-bold tracking-wide text-[#94969C]\" data-kid=\"1-2-2-6\" data-name=\"voice channel section header\">\n                <span data-kid=\"1-2-2-6-1\" data-name=\"voice channel section label\">\n                    KÊNH GẶP\n                </span>\n                <i class=\"ph ph-plus text-[15px]\" data-kid=\"1-2-2-6-2\" data-name=\"add channel plus icon\">\n                </i>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-md bg-[#3B3D44] px-2.5 py-2 text-[14px] font-semibold text-white\" data-kid=\"1-2-2-7\" data-name=\"active voice channel item\">\n                <i class=\"ph ph-speaker-high text-[17px] text-[#B9BAC0]\" data-kid=\"1-2-2-7-1\" data-name=\"speaker icon\">\n                </i>\n                <span class=\"truncate\" data-kid=\"1-2-2-7-2\" data-name=\"voice channel name\">\n                    Phòng học nhóm\n                </span>\n            </div>\n            <div class=\"mt-1 pl-8 text-[12px] text-[#94969C]\" data-kid=\"1-2-2-8\" data-name=\"voice channel user count text\">\n                4 người trong bản xem trước\n            </div>\n            <div class=\"mt-5 rounded-md px-2.5 py-2 text-[13px] text-[#94969C]\" data-kid=\"1-2-2-9\" data-name=\"games placeholder row\">\n                <i class=\"ph ph-game-controller mr-2 text-[16px]\" data-kid=\"1-2-2-9-1\" data-name=\"game controller icon\">\n                </i>\n                Trò chơi · Chưa tích hợp\n            </div>\n        </div>\n        <div class=\"mt-auto border-t border-[#17181B] p-2\" data-kid=\"1-2-3\" data-name=\"sidebar footer panel\">\n            <div class=\"rounded-md bg-[#25262A] p-2.5\" data-kid=\"1-2-3-1\" data-name=\"voice preview status card\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-1\" data-name=\"voice status header\">\n                    <i class=\"ph ph-waveform-slash text-[18px] text-[#AFB1B6]\" data-kid=\"1-2-3-1-1-1\" data-name=\"waveform-slash icon\">\n                    </i>\n                    <span class=\"text-[13px] font-bold text-[#E2E3E6]\" data-kid=\"1-2-3-1-1-2\" data-name=\"voice channel status title\">\n                        Phòng học nhóm\n                    </span>\n                </div>\n                <div class=\"mt-1.5 pl-[26px] text-[11px] leading-[1.35] text-[#AFB1B6]\" data-kid=\"1-2-3-1-2\" data-name=\"voice status detail text\">\n                    Bản xem trước\n                    <br data-kid=\"1-2-3-1-2-1\" data-name=\"line break\"/>\n                    Media adapter chưa kết nối\n                </div>\n                <div class=\"mt-2 flex items-center gap-1.5 border-t border-[#36383D] pt-2 text-[11px] text-[#94969C]\" data-kid=\"1-2-3-1-3\" data-name=\"voice status unavailable notice\">\n                    <i class=\"ph ph-info text-[14px]\" data-kid=\"1-2-3-1-3-1\" data-name=\"info icon\">\n                    </i>\n                    Điều khiển hiện chưa khả dụng\n                </div>\n            </div>\n            <div class=\"mt-2 flex items-center gap-2 rounded-md px-1.5 py-1.5 hover:bg-[#34363B]\" data-kid=\"1-2-3-2\" data-name=\"user profile row\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#5865F2] text-[10px] font-bold text-white\" data-kid=\"1-2-3-2-1\" data-name=\"user avatar initial\">\n                    HN\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-2\" data-name=\"profile text container\">\n                    <div class=\"truncate text-[13px] font-bold\" data-kid=\"1-2-3-2-2-1\" data-name=\"user full name\">\n                        Hà Nguyễn\n                    </div>\n                    <div class=\"truncate text-[11px] text-[#94969C]\" data-kid=\"1-2-3-2-2-2\" data-name=\"user profile subtitle\">\n                        Hồ sơ của bạn\n                    </div>\n                </div>\n                <i class=\"ph ph-gear-six text-[17px] text-[#AFB1B6]\" data-kid=\"1-2-3-2-3\" data-name=\"settings gear icon\">\n                </i>\n            </div>\n        </div>\n    </aside>\n    <!-- Meeting canvas -->\n    <main class=\"relative flex min-w-0 flex-1 flex-col bg-[#27292D]\" data-kid=\"1-3\" data-name=\"meeting main canvas\">\n        <header class=\"flex h-12 shrink-0 items-center justify-between border-b border-[#202226] px-5\" data-kid=\"1-3-1\" data-name=\"meeting top header\">\n            <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-3-1-1\" data-name=\"meeting title and group breadcrumb\">\n                <i class=\"ph ph-speaker-high text-[19px] text-[#AFB1B6]\" data-kid=\"1-3-1-1-1\" data-name=\"speaker icon\">\n                </i>\n                <span class=\"truncate text-[14px