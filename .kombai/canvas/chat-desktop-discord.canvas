      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"flex h-[900px] w-full overflow-hidden bg-[#27292d] font-['Nunito_Sans',sans-serif] text-[#eaebee]\" data-kid=\"1\" data-name=\"chat application layout container\">\n    <aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-3 bg-[#151619] py-4\" data-kid=\"1-1\" data-name=\"community rail navigation sidebar\">\n        <div class=\"relative flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#5e68f7] text-lg font-extrabold text-white shadow-sm\" data-kid=\"1-1-1\" data-name=\"active community avatar button (messages)\" title=\"Tin nhắn\">\n            <i class=\"ph ph-chat-circle-dots text-[24px] text-white\" data-kid=\"1-1-1-1\" data-name=\"chat bubble icon\">\n            </i>\n        </div>\n        <div class=\"h-px w-8 bg-[#383a40]\" data-kid=\"1-1-2\" data-name=\"vertical divider line\">\n        </div>\n        <div class=\"relative flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#3b3d44] text-sm font-extrabold text-[#f5f5f6]\" data-kid=\"1-1-3\" data-name=\"active LTM Studio community avatar button\" title=\"LTM Studio\">\n            <span class=\"absolute -left-[12px] h-8 w-1 rounded-r-full bg-white\" data-kid=\"1-1-3-1\" data-name=\"active state indicator bar\">\n            </span>\n            LT\n        </div>\n        <div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#292a2f] text-sm font-bold text-[#c7c8ce]\" data-kid=\"1-1-4\" data-name=\"learning group community avatar button\" title=\"Nhóm học tập\">\n            HT\n        </div>\n        <button aria-label=\"Thêm cộng đồng\" class=\"flex h-12 w-12 items-center justify-center rounded-full text-[#43c07a] hover:bg-[#292a2f]\" data-kid=\"1-1-5\" data-name=\"add community button\">\n            <i class=\"ph ph-plus text-[22px] text-[#43c07a]\" data-kid=\"1-1-5-1\" data-name=\"plus icon\">\n            </i>\n        </button>\n        <button aria-label=\"Khám phá cộng đồng\" class=\"flex h-12 w-12 items-center justify-center rounded-full text-[#43c07a] hover:bg-[#292a2f]\" data-kid=\"1-1-6\" data-name=\"explore communities button\">\n            <i class=\"ph ph-compass text-[22px] text-[#43c07a]\" data-kid=\"1-1-6-1\" data-name=\"compass icon\">\n            </i>\n        </button>\n        <div class=\"mt-auto flex h-10 w-10 items-center justify-center rounded-full bg-[#5c688c] text-xs font-bold text-white\" data-kid=\"1-1-7\" data-name=\"current user profile avatar\">\n            MA\n        </div>\n    </aside>\n    <aside class=\"flex w-[240px] shrink-0 flex-col bg-[#1e1f23]\" data-kid=\"1-2\" data-name=\"channel and user sidebar panel\">\n        <button aria-label=\"Mở menu LTM Studio\" class=\"flex h-[56px] items-center justify-between border-b border-[#18191c] px-4 text-left hover:bg-[#28292e]\" data-kid=\"1-2-1\" data-name=\"workspace switcher header button\">\n            <span class=\"truncate text-[15px] font-bold\" data-kid=\"1-2-1-1\" data-name=\"workspace name label\">\n                LTM Studio\n            </span>\n            <i class=\"ph ph-caret-down text-[16px] text-[#afb1b6]\" data-kid=\"1-2-1-2\" data-name=\"dropdown caret icon\">\n            </i>\n        </button>\n        <div class=\"px-2 pt-3\" data-kid=\"1-2-2\" data-name=\"channel navigation list\">\n            <button class=\"flex h-9 w-full items-center gap-3 rounded-md px-2.5 text-left text-[14px] text-[#afb1b6] hover:bg-[#2b2c31] hover:text-[#eaebee]\" data-kid=\"1-2-2-1\" data-name=\"mailbox navigation item with badge\">\n                <i class=\"ph ph-inbox text-[18px] text-[#afb1b6]\" data-kid=\"1-2-2-1-1\" data-name=\"inbox icon\">\n                </i>\n                <span class=\"flex-1\" data-kid=\"1-2-2-1-2\" data-name=\"mailbox label text\">\n                    Hộp thư\n                </span>\n                <span class=\"rounded bg-[#5e68f7] px-1.5 text-[12px] font-bold text-white\" data-kid=\"1-2-2-1-3\" data-name=\"unread count badge\">\n                    2\n                </span>\n            </button>\n            <button class=\"mt-0.5 flex h-9 w-full items-center gap-3 rounded-md px-2.5 text-left text-[14px] text-[#afb1b6] hover:bg-[#2b2c31] hover:text-[#eaebee]\" data-kid=\"1-2-2-2\" data-name=\"messages navigation item\">\n                <i class=\"ph ph-chat-circle-text text-[18px] text-[#afb1b6]\" data-kid=\"1-2-2-2-1\" data-name=\"chat message icon\">\n                </i>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"messages label text\">\n                    Tin nhắn\n                </span>\n            </button>\n            <div class=\"mt-3 flex h-8 items-center justify-between px-2.5 text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-2-2-3\" data-name=\"text channels section header\">\n                <span data-kid=\"1-2-2-3-1\" data-name=\"text channels section title\">\n                    KÊNH VĂN BẢN\n                </span>\n                <button aria-label=\"Thêm kênh văn bản\" class=\"flex h-6 w-6 items-center justify-center rounded text-[#afb1b6] hover:bg-[#2b2c31]\" data-kid=\"1-2-2-3-2\" data-name=\"add text channel button\">\n                    <i class=\"ph ph-plus text-[16px]\" data-kid=\"1-2-2-3-2-1\" data-name=\"plus icon\">\n                    </i>\n                </button>\n            </div>\n            <button class=\"flex h-9 w-full items-center gap-2 rounded-md px-2.5 text-[14px] text-[#afb1b6] hover:bg-[#2b2c31] hover:text-[#eaebee]\" data-kid=\"1-2-2-4\" data-name=\"#chung text channel item\">\n                <i class=\"ph ph-hash text-[17px] text-[#7b7e87]\" data-kid=\"1-2-2-4-1\" data-name=\"hash icon\">\n                </i>\n                <span data-kid=\"1-2-2-4-2\" data-name=\"channel name text\">\n                    chung\n                </span>\n            </button>\n            <button class=\"flex h-9 w-full items-center gap-2 rounded-md px-2.5 text-[14px] text-[#afb1b6] hover:bg-[#2b2c31] hover:text-[#eaebee]\" data-kid=\"1-2-2-5\" data-name=\"#chia-sẻ-tài-liệu text channel item\">\n                <i class=\"ph ph-hash text-[17px] text-[#7b7e87]\" data-kid=\"1-2-2-5-1\" data-name=\"hash icon\">\n                </i>\n                <span data-kid=\"1-2-2-5-2\" data-name=\"channel name text\">\n                    chia-sẻ-tài-liệu\n                </span>\n            </button>\n            <div class=\"mt-4 flex h-8 items-center justify-between px-2.5 text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-2-2-6\" data-name=\"voice channels section header\">\n                <span data-kid=\"1-2-2-6-1\" data-name=\"voice channels section title\">\n                    KÊNH GẶP\n                </span>\n                <button aria-label=\"Thêm kênh gặp\" class=\"flex h-6 w-6 items-center justify-center rounded text-[#afb1b6] hover:bg-[#2b2c31]\" data-kid=\"1-2-2-6-2\" data-name=\"add voice channel button\">\n                    <i class=\"ph ph-plus text-[16px]\" data-kid=\"1-2-2-6-2-1\" data-name=\"plus icon\">\n                    </i>\n                </button>\n            </div>\n            <button aria-current=\"page\" class=\"flex h-9 w-full items-center gap-2 rounded-md bg-[#3b3d44] px-2.5 text-[14px] font-semibold text-white\" data-kid=\"1-2-2-7\" data-name=\"active voice channel item (phòng-họp)\">\n                <i class=\"ph ph-speaker-high text-[17px] text-[#d3d4d7]\" data-kid=\"1-2-2-7-1\" data-name=\"speaker icon\">\n                </i>\n                <span class=\"flex-1 truncate\" data-kid=\"1-2-2-7-2\" data-name=\"voice channel name text\">\n                    phòng-họp\n                </span>\n                <i class=\"ph ph-gear-six text-[15px] text-[#afb1b6]\" data-kid=\"1-2-2-7-3\" data-name=\"channel settings gear icon\">\n                </i>\n            </button>\n            <div class=\"ml-8 mt-1 space-y-1 pb-1\" data-kid=\"1-2-2-8\" data-name=\"channel users list container\">\n                <div class=\"flex items-center gap-2 px-1 py-1 text-[12px] text-[#8f929a]\" data-kid=\"1-2-2-8-1\" data-name=\"channel user count row\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#6c6e76]\" data-kid=\"1-2-2-8-1-1\" data-name=\"inactive user presence dot\">\n                    </span>\n                    2 người · danh sách mẫu\n                </div>\n            </div>\n            <div class=\"mt-2 flex h-8 items-center justify-between px-2.5 text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-2-2-9\" data-name=\"games section header\">\n                <span data-kid=\"1-2-2-9-1\" data-name=\"games section title\">\n                    TRÒ CHƠI\n                </span>\n                <i class=\"ph ph-plus text-[14px] text-[#767982]\" data-kid=\"1-2-2-9-2\" data-name=\"add game plus icon\">\n                </i>\n            </div>\n            <div class=\"flex items-start gap-2 px-2.5 py-1.5 text-[13px] text-[#858790]\" data-kid=\"1-2-2-10\" data-name=\"games unavailable item\">\n                <i class=\"ph ph-game-controller text-[17px] text-[#777a83]\" data-kid=\"1-2-2-10-1\" data-name=\"game controller icon\">\n                </i>\n                <span class=\"leading-[18px]\" data-kid=\"1-2-2-10-2\" data-name=\"games item text\">\n                    Trò chơi\n                    <br data-kid=\"1-2-2-10-2-1\" data-name=\"line break\"/>\n                    <span class=\"text-[12px] text-[#747780]\" data-kid=\"1-2-2-10-2-2\" data-name=\"not integrated subtitle\">\n                        Chưa tích hợp\n                    </span>\n                </span>\n            </div>\n        </div>\n        <div class=\"mt-auto px-2 pb-2\" data-kid=\"1-2-3\" data-name=\"voice status and user footer block\">\n            <div class=\"mb-2 rounded-md bg-[#191a1e] px-2.5 py-2.5\" data-kid=\"1-2-3-1\" data-name=\"voice connection status card\">\n                <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#afb1b6]\" data-kid=\"1-2-3-1-1\" data-name=\"disconnected voice status row\">\n                    <i class=\"ph ph-headphones text-[16px] text-[#858891]\" data-kid=\"1-2-3-1-1-1\" data-name=\"headphones icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-1-1-2\" data-name=\"disconnected status label\">\n                        Chưa tham gia kênh gặp\n                    </span>\n                </div>\n                <div class=\"mt-1 pl-6 text-[12px] text-[#747780]\" data-kid=\"1-2-3-1-2\" data-name=\"connection detail text\">\n                    Kết nối chưa hoạt động\n                </div>\n            </div>\n            <div class=\"flex h-[52px] items-center gap-2 rounded-md px-1.5 hover:bg-[#28292e]\" data-kid=\"1-2-3-2\" data-name=\"current user profile bar\">\n                <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#5c688c] text-[11px] font-bold text-white\" data-kid=\"1-2-3-2-1\" data-name=\"current user avatar circle\">\n                    MA\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-2\" data-name=\"user info block\">\n                    <div class=\"truncate text-[13px] font-bold\" data-kid=\"1-2-3-2-2-1\" data-name=\"username text\">\n                        Minh Anh\n                    </div>\n                    <div class=\"text-[12px] text-[#afb1b6]\" data-kid=\"1-2-3-2-2-2\" data-name=\"user status text\">\n                        Đang trực tuyến · mẫu\n                    </div>\n                </div>\n                <button aria-label=\"Cài đặt tài khoản\" class=\"flex h-7 w-7 items-center justify-center rounded text-[#afb1b6] hover:bg-[#34363d]\" data-kid=\"1-2-3-2-3\" data-name=\"account settings button\">\n                    <i class=\"ph ph-gear-six text-[17px]\" data-kid=\"1-2-3-2-3-1\" data-name=\"gear settings icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </aside>\n    <main class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-3\" data-name=\"main meeting area column\">\n        <header class=\"flex h-[56px] shrink-0 items-center justify-between border-b border-[#202125] px-5\" data-kid=\"1-3-1\" data-name=\"channel header bar\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-1-1\" data-name=\"channel title block\">\n                <i class=\"ph ph-speaker-high text-[21px] text-[#b9bbc1]\" data-kid=\"1-3-1-1-1\" data-name=\"speaker icon\">\n                </i>\n                <span class=\"truncate text-[15px] font-bold\" data-kid=\"1-3-1-1-2\" data-name=\"channel name text\">\n                    phòng-họp\n                </span>\n                <span class=\"h-5 w-px bg-[#45474d]\" data-kid=\"1-3-1-1-3\" data-name=\"title divider line\">\n                </span>\n                <span class=\"truncate text-[13px] text-[#afb1b6]\" data-kid=\"1-3-1-1-4\" data-name=\"channel description text\">\n                    Kênh gặp của LTM Studio\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-2\" data-name=\"header actions toolbar\">\n                <div class=\"flex items-center gap-1.5 rounded px-2 py-1 text-[12px] font-semibold text-[#afb1b6]\" data-kid=\"1-3-1-2-1\" data-name=\"preview mode badge\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#f0bb3b]\" data-kid=\"1-3-1-2-1-1\" data-name=\"preview status dot\">\n                    </span>\n                    Chế độ xem trước\n                </div>\n                <button aria-label=\"Tìm kiếm\" class=\"flex h-8 w-8 items-center justify-center rounded text-[#afb1b6] hover:bg-[#36383e]\" data-kid=\"1-3-1-2-2\" data-name=\"search button\">\n                    <i class=\"ph ph-magnifying-glass text-[18px]\" data-kid=\"1-3-1-2-2-1\" data-name=\"magnifying glass icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Thành viên\" class=\"flex h-8 w-8 items-center justify-center rounded bg-[#3b3d44] text-[#eaebee]\" data-kid=\"1-3-1-2-3\" data-name=\"members button\">\n                    <i class=\"ph ph-users-three text-[18px]\" data-kid=\"1-3-1-2-3-1\" data-name=\"three users icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Tùy chọn khác\" class=\"flex h-8 w-8 items-center justify-center rounded text-[#afb1b6] hover:bg-[#36383e]\" data-kid=\"1-3-1-2-4\" data-name=\"more options button\">\n                    <i class=\"ph ph-dots-three-vertical text-[18px]\" data-kid=\"1-3-1-2-4-1\" data-name=\"vertical dots icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <div class=\"flex min-h-0 flex-1\" data-kid=\"1-3-2\" data-name=\"meeting content and participants row\">\n            <section class=\"flex min-w-0 flex-1 flex-col items-center overflow-y-auto px-8 pb-8 pt-7\" data-kid=\"1-3-2-1\" data-name=\"meeting stage section\">\n                <div class=\"w-full max-w-[740px]\" data-kid=\"1-3-2-1-1\" data-name=\"meeting stage inner container\">\n                    <div class=\"mb-5\" data-kid=\"1-3-2-1-1-1\" data-name=\"headline block\">\n                        <h1 class=\"text-[24px] font-extrabold tracking-[-0.3px] text-[#f2f3f5]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"meeting headline text\">\n                            Sẵn sàng vào phòng?\n                        </h1>\n                        <p class=\"mt-1.5 text-[14px] text-[#afb1b6]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"meeting subheadline text\">\n                            Chọn thiết bị trước khi tham gia\n                            <span class=\"font-semibold text-[#d5d6da]\" data-kid=\"1-3-2-1-1-1-2-1\" data-name=\"channel name emphasis\">\n                                # phòng-họp\n                            </span>\n                            .\n                        </p>\n                    </div>\n                    <div class=\"relative flex h-[320px] w-full flex-col items-center justify-center overflow-hidden rounded-[10px] bg-[#202126]\" data-kid=\"1-3-2-1-1-2\" data-name=\"camera preview card\">\n                        <div class=\"mb-4 flex h-[72px] w-[72px] items-center justify-center rounded-full bg-[#303137] text-[#a9abb2]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"camera off avatar circle\">\n                            <i class=\"ph ph-video-camera-slash text-[34px] text-[#a9abb2]\" data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"camera off icon\">\n                            </i>\n                        </div>\n                        <div class=\"text-[16px] font-bold text-[#e4e5e8]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"camera status title\">\n                            Camera chưa được bật\n                        </div>\n                        <div class=\"mt-1.5 max-w-[380px] text-center text-[13px] leading-5 text-[#afb1b6]\" data-kid=\"1-3-2-1-1-2-3\" data-name=\"camera status description\">\n                            Không có hình ảnh hoặc âm thanh nào được khởi chạy ở màn hình chờ này.\n                        </div>\n                        <div class=\"mt-4 flex items-center gap-1.5 rounded-md bg-[#292a30] px-2.5 py-1.5 text-[12px] font-semibold text-[#d0d1d5]\" data-kid=\"1-3-2-1-1-2-4\" data-name=\"preview unavailable badge\">\n                            <i class=\"ph ph-eye-slash text-[15px] text-[#afb1b6]\" data-kid=\"1-3-2-1-1-2-4-1\" data-name=\"eye slash icon\">\n                            </i>\n                            Bản xem trước chưa khả dụng\n                        </div>\n                        <div class=\"absolute bottom-3 left-4 text-[12px] text-[#82858e]\" data-kid=\"1-3-2-1-1-2-5\" data-name=\"media footer note\">\n                            Media chưa tích hợp · không kết nối thiết bị\n                        </div>\n                    </div>\n                    <div class=\"mt-5 grid grid-cols-2 gap-3\" data-kid=\"1-3-2-1-1-3\" data-name=\"device selection grid\">\n                        <div class=\"rounded-[8px] bg-[#2d2f34] p-3.5\" data-kid=\"1-3-2-1-1-3-1\" data-name=\"microphone selection card\">\n                            <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-3-2-1-1-3-1-1\" data-name=\"microphone header row\">\n                                <label class=\"text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-3-2-1-1-3-1-1-1\" data-name=\"microphone label\">\n                                    MICRÔ\n                                </label>\n                                <span class=\"flex items-center gap-1 text-[12px] font-semibold text-[#f0bb3b]\" data-kid=\"1-3-2-1-1-3-1-1-2\" data-name=\"microphone status badge\">\n                                    <i class=\"ph ph-minus-circle text-[14px]\" data-kid=\"1-3-2-1-1-3-1-1-2-1\" data-name=\"minus circle icon\">\n                                    </i>\n                                    Chưa kết nối\n                                </span>\n                            </div>\n                            <button aria-label=\"Chọn thiết bị micrô, hiện chưa kết nối\" class=\"flex h-10 w-full items-center justify-between rounded-md bg-[#202126] px-3 text-left text-[13px] text-[#c5c6cb]\" data-kid=\"1-3-2-1-1-3-1-2\" data-name=\"microphone device selector button\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-3-2-1-1-3-1-2-1\" data-name=\"microphone value text block\">\n                                    <i class=\"ph ph-microphone-slash text-[17px] text-[#898c95]\" data-kid=\"1-3-2-1-1-3-1-2-1-1\" data-name=\"microphone slash icon\">\n                                    </i>\n                                    Chưa chọn thiết bị\n                                </span>\n                                <i class=\"ph ph-caret-down text-[15px] text-[#8e9098]\" data-kid=\"1-3-2-1-1-3-1-2-2\" data-name=\"dropdown caret icon\">\n                                </i>\n                            </button>\n                            <div class=\"mt-2 text-[12px] text-[#898c95]\" data-kid=\"1-3-2-1-1-3-1-3\" data-name=\"microphone detail note\">\n                                Âm thanh chưa khởi chạy · danh sách thiết bị chưa có\n                            </div>\n                        </div>\n                        <div class=\"rounded-[8px] bg-[#2d2f34] p-3.5\" data-kid=\"1-3-2-1-1-3-2\" data-name=\"camera selection card\">\n                            <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-3-2-1-1-3-2-1\" data-name=\"camera header row\">\n                                <label class=\"text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-3-2-1-1-3-2-1-1\" data-name=\"camera label\">\n                                    CAMERA\n                                </label>\n                                <span class=\"flex items-center gap-1 text-[12px] font-semibold text-[#f0bb3b]\" data-kid=\"1-3-2-1-1-3-2-1-2\" data-name=\"camera status badge\">\n                                    <i class=\"ph ph-minus-circle text-[14px]\" data-kid=\"1-3-2-1-1-3-2-1-2-1\" data-name=\"minus circle icon\">\n                                    </i>\n                                    Chưa kết nối\n                                </span>\n                            </div>\n                            <button aria-label=\"Chọn thiết bị camera, hiện chưa kết nối\" class=\"flex h-10 w-full items-center justify-between rounded-md bg-[#202126] px-3 text-left text-[13px] text-[#c5c6cb]\" data-kid=\"1-3-2-1-1-3-2-2\" data-name=\"camera device selector button\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-3-2-1-1-3-2-2-1\" data-name=\"camera value text block\">\n                                    <i class=\"ph ph-video-camera text-[17px] text-[#898c95]\" data-kid=\"1-3-2-1-1-3-2-2-1-1\" data-name=\"camera icon\">\n                                    </i>\n                                    Chưa chọn thiết bị\n                                </span>\n                                <i class=\"ph ph-caret-down text-[15px] text-[#8e9098]\" data-kid=\"1-3-2-1-1-3-2-2-2\" data-name=\"dropdown caret icon\">\n                                </i>\n                            </button>\n                            <div class=\"mt-2 text-[12px] text-[#898c95]\" data-kid=\"1-3-2-1-1-3-2-3\" data-name=\"camera detail note\">\n                                Bản xem trước chưa khả dụng · media chưa tích hợp\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between rounded-md bg-[#222328] px-4 py-3\" data-kid=\"1-3-2-1-1-4\" data-name=\"info banner with join action\">\n                        <div class=\"flex max-w-[425px] items-start gap-2.5 text-[13px] leading-[19px] text-[#afb1b6]\" data-kid=\"1-3-2-1-1-4-1\" data-name=\"info message block\">\n                            <i class=\"ph ph-info mt-0.5 text-[16px] text-[#a8aab1]\" data-kid=\"1-3-2-1-1-4-1-1\" data-name=\"info icon\">\n                            </i>\n                            <span data-kid=\"1-3-2-1-1-4-1-2\" data-name=\"info description text\">\n                                Đây là giao diện chờ. Hệ thống TCP/JSON hiện tại chưa xác nhận hỗ trợ truyền âm thanh hoặc video.\n                            </span>\n                        </div>\n                        <button aria-label=\"Vào phòng (hành động chờ tích hợp)\" class=\"ml-4 flex h-10 shrink-0 items-center gap-2 rounded-[6px] bg-[#5e68f7] px-5 text-[14px] font-bold text-white hover:bg-[#6d76ff]\" data-kid=\"1-3-2-1-1-4-2\" data-name=\"join meeting button\">\n                            <i class=\"ph ph-sign-in text-[18px] text-white\" data-kid=\"1-3-2-1-1-4-2-1\" data-name=\"sign in icon\">\n                            </i>\n                            Vào phòng\n                        </button>\n                    </div>\n                    <div class=\"mt-2.5 text-right text-[12px] text-[#858790]\" data-kid=\"1-3-2-1-1-5\" data-name=\"join action footer note\">\n                        Thao tác vào phòng sẽ khả dụng sau khi tích hợp dịch vụ media.\n                    </div>\n                </div>\n            </section>\n            <aside class=\"flex w-[224px] shrink-0 flex-col border-l border-[#202125] bg-[#1e1f23] px-3.5 pt-5\" data-kid=\"1-3-2-2\" data-name=\"participants sidebar panel\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-3-2-2-1\" data-name=\"participants header row\">\n                    <h2 class=\"text-[14px] font-bold text-[#e2e3e7]\" data-kid=\"1-3-2-2-1-1\" data-name=\"participants title\">\n                        Người tham gia\n                    </h2>\n                    <span class=\"text-[12px] text-[#afb1b6]\" data-kid=\"1-3-2-2-1-2\" data-name=\"participants sample badge\">\n                        Mẫu\n                    </span>\n                </div>\n                <div class=\"mt-1.5 text-[12px] leading-[18px] text-[#898c95]\" data-kid=\"1-3-2-2-2\" data-name=\"participants subtitle\">\n                    Danh sách minh họa · chưa kết nối phòng\n                </div>\n                <div class=\"mt-5 text-[12px] font-bold text-[#afb1b6]\" data-kid=\"1-3-2-2-3\" data-name=\"in-room section label\">\n                    ĐANG Ở TRONG PHÒNG — MẪU\n                </div>\n                <div class=\"mt-2 space-y-1\" data-kid=\"1-3-2-2-4\" data-name=\"in-room participants list\">\n                    <div class=\"flex h-11 items-center gap-2.5 rounded-md px-1.5\" data-kid=\"1-3-2-2-4-1\" data-name=\"participant row (Minh Anh)\">\n                        <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#58648a] text-[11px] font-bold text-white\" data-kid=\"1-3-2-2-4-1-1\" data-name=\"participant avatar\">\n                            MA\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-3-2-2-4-1-2\" data-name=\"participant info block\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#e4e5e8]\" data-kid=\"1-3-2-2-4-1-2-1\" data-name=\"participant name text\">\n                                Minh Anh\n                            </div>\n                            <div class=\"text-[12px] text-[#8c8f98]\" data-kid=\"1-3-2-2-4-1-2-2\" data-name=\"participant status text\">\n                                Mẫu · chưa kết nối\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex h-11 items-center gap-2.5 rounded-md px-1.5\" data-kid=\"1-3-2-2-4-2\" data-name=\"participant row (Khánh Linh)\">\n                        <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#8b675e] text-[11px] font-bold text-white\" data-kid=\"1-3-2-2-4-2-1\" data-name=\"participant avatar\">\n                            KL\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-3-2-2-4-2-2\" data-name=\"participant info block\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#e4e5e8]\" data-kid=\"1-3-2-2-4-2-2-1\" data-name=\"participant name text\">\n                                Khánh Linh\n                            </div>\n                            <div class=\"text-[12px] text-[#8c8f98]\" data-kid=\"1-3-2-2-4-2-2-2\" data-name=\"participant status text\">\n                                Mẫu · chưa kết nối\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex h-11 items-center gap-2.5 rounded-md px-1.5\" data-kid=\"1-3-2-2-4-3\" data-name=\"participant row (Hữu Phúc)\">\n                        <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#687d5e] text-[11px] font-bold text-white\" data-kid=\"1-3-2-2-4-3-1\" data-name=\"participant avatar\">\n                            HP\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-3-2-2-4-3-2\" data-name=\"participant info block\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#e4e5e8]\" data-kid=\"1-3-2-2-4-3-2-1\" data-name=\"participant name text\">\n                                Hữu Phúc\n                            </div>\n                            <div class=\"text-[12px] text-[#8c8f98]\" data-kid=\"1-3-2-2-4-3-2-2\" data-name=\"participant status text\">\n                                Mẫu · chưa kết nối\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-auto mb-4 rounded-md bg-[#25262b] px-3 py-3\" data-kid=\"1-3-2-2-5\" data-name=\"media status card\">\n                    <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#c3c5ca]\" data-kid=\"1-3-2-2-5-1\" data-name=\"media status row\">\n                        <i class=\"ph ph-plugs-connected text-[16px] text-[#8d9098]\" data-kid=\"1-3-2-2-5-1-1\" data-name=\"plugs connected icon\">\n                        </i>\n                        Media chưa sẵn sàng\n                    </div>\n                    <p class=\"mt-1.5 text-[12px] leading-[18px] text-[#898c95]\" data-kid=\"1-3-2-2-5-2\" data-name=\"media status description\">\n                        Không có trạng thái mic, camera hoặc người tham gia trực tuyến.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
