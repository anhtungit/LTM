      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n</style>\n<div class=\"h-[900px] w-[1440px] overflow-hidden bg-[#27292D] font-[Nunito_Sans,sans-serif] text-[#EAEBEE] antialiased\" data-kid=\"1\">\n    <div class=\"flex h-full w-full\" data-kid=\"1-1\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#151619] py-3\" data-kid=\"1-1-1\">\n            <div class=\"relative mb-3 flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#5865F2] text-white shadow-sm\" data-kid=\"1-1-1-1\">\n                <i class=\"ph ph-chat-circle-dots text-[25px]\" data-kid=\"1-1-1-1-1\">\n                </i>\n                <span class=\"absolute -left-[13px] top-1/2 h-8 w-1 -translate-y-1/2 rounded-r-full bg-white\" data-kid=\"1-1-1-1-2\">\n                </span>\n            </div>\n            <div class=\"mb-3 h-px w-8 bg-[#34363B]\" data-kid=\"1-1-1-2\">\n            </div>\n            <div class=\"relative mb-2 flex h-12 w-12 items-center justify-center rounded-[17px] bg-[#3B3D44] text-[13px] font-extrabold tracking-wide text-[#D8DAE0]\" data-kid=\"1-1-1-3\">\n                LT\n                <span class=\"absolute -left-[13px] top-1/2 h-2 w-1 -translate-y-1/2 rounded-r-full bg-white\" data-kid=\"1-1-1-3-1\">\n                </span>\n            </div>\n            <div class=\"mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-[#24262B] text-[12px] font-bold text-[#A8AAB1]\" data-kid=\"1-1-1-4\">\n                CL\n            </div>\n            <div class=\"mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-[#24262B] text-[12px] font-bold text-[#A8AAB1]\" data-kid=\"1-1-1-5\">\n                UI\n            </div>\n            <button aria-label=\"Thêm cộng đồng\" class=\"mt-1 flex h-12 w-12 items-center justify-center rounded-full bg-[#24262B] text-[#43C07A]\" data-kid=\"1-1-1-6\">\n                <i class=\"ph ph-plus text-[22px]\" data-kid=\"1-1-1-6-1\">\n                </i>\n            </button>\n            <button aria-label=\"Khám phá cộng đồng\" class=\"mt-2 flex h-12 w-12 items-center justify-center rounded-full bg-[#24262B] text-[#43C07A]\" data-kid=\"1-1-1-7\">\n                <i class=\"ph ph-compass text-[22px]\" data-kid=\"1-1-1-7-1\">\n                </i>\n            </button>\n            <div class=\"mt-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-[#24262B] text-[#AFB1B6]\" data-kid=\"1-1-1-8\">\n                <i class=\"ph ph-download-simple text-[20px]\" data-kid=\"1-1-1-8-1\">\n                </i>\n            </div>\n        </aside>\n        <aside class=\"flex w-[240px] shrink-0 flex-col bg-[#1E1F23]\" data-kid=\"1-1-2\">\n            <div class=\"flex h-[54px] shrink-0 items-center justify-between border-b border-[#17181B] px-4\" data-kid=\"1-1-2-1\">\n                <span class=\"text-[15px] font-extrabold tracking-tight\" data-kid=\"1-1-2-1-1\">\n                    Tin nhắn trực tiếp\n                </span>\n                <button aria-label=\"Tin nhắn mới\" class=\"flex h-7 w-7 items-center justify-center rounded text-[#B6B7BE]\" data-kid=\"1-1-2-1-2\">\n                    <i class=\"ph ph-note-pencil text-[18px]\" data-kid=\"1-1-2-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"px-3 pt-3\" data-kid=\"1-1-2-2\">\n                <div class=\"flex h-[34px] items-center gap-2 rounded-md bg-[#151619] px-2.5 text-[12px] text-[#92949C]\" data-kid=\"1-1-2-2-1\">\n                    <i class=\"ph ph-magnifying-glass text-[15px]\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-1-2\">\n                        Tìm kiếm\n                    </span>\n                    <span class=\"ml-auto rounded bg-[#25262A] px-1 py-0.5 text-[10px] text-[#777A82]\" data-kid=\"1-1-2-2-1-3\">\n                        Ctrl K\n                    </span>\n                </div>\n                <button class=\"mt-3 flex h-[38px] w-full items-center gap-3 rounded-md px-2.5 text-left text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-2\">\n                    <i class=\"ph ph-tray text-[18px]\" data-kid=\"1-1-2-2-2-1\">\n                    </i>\n                    Hộp thư\n                    <span class=\"ml-auto flex h-[17px] min-w-[17px] items-center justify-center rounded-full bg-[#ED4245] px-1 text-[10px] font-bold text-white\" data-kid=\"1-1-2-2-2-2\">\n                        2\n                    </span>\n                </button>\n                <div class=\"mb-1 mt-4 flex items-center justify-between px-2.5 text-[10px] font-extrabold uppercase tracking-[.09em] text-[#92949C]\" data-kid=\"1-1-2-2-3\">\n                    <span data-kid=\"1-1-2-2-3-1\">\n                        Tin nhắn trực tiếp\n                    </span>\n                    <i class=\"ph ph-plus text-[14px]\" data-kid=\"1-1-2-2-3-2\">\n                    </i>\n                </div>\n                <div class=\"flex h-[42px] items-center gap-2 rounded-md bg-[#3B3D44] px-2.5 text-[13px] font-semibold text-white\" data-kid=\"1-1-2-2-4\">\n                    <div class=\"relative flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-full bg-[#D28B82] text-[11px] font-extrabold text-[#281B1A]\" data-kid=\"1-1-2-2-4-1\">\n                        MP\n                        <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-2 border-[#3B3D44] bg-[#43C07A]\" data-kid=\"1-1-2-2-4-1-1\">\n                        </span>\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-4-2\">\n                        Mai Phương\n                    </span>\n                    <span class=\"ml-auto text-[10px] text-[#C9CAD0]\" data-kid=\"1-1-2-2-4-3\">\n                        09:47\n                    </span>\n                </div>\n                <div class=\"mt-1 flex h-[42px] items-center gap-2 rounded-md px-2.5 text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-5\">\n                    <div class=\"flex h-[30px] w-[30px] items-center justify-center rounded-full bg-[#89A9D0] text-[11px] font-extrabold text-[#152131]\" data-kid=\"1-1-2-2-5-1\">\n                        AN\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-5-2\">\n                        An Nguyễn\n                    </span>\n                </div>\n                <div class=\"flex h-[42px] items-center gap-2 rounded-md px-2.5 text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-6\">\n                    <div class=\"relative flex h-[30px] w-[30px] items-center justify-center rounded-full bg-[#A5B87F] text-[11px] font-extrabold text-[#202719]\" data-kid=\"1-1-2-2-6-1\">\n                        DK\n                        <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-2 border-[#1E1F23] bg-[#43C07A]\" data-kid=\"1-1-2-2-6-1-1\">\n                        </span>\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-6-2\">\n                        Đức Khánh\n                    </span>\n                </div>\n                <div class=\"flex h-[42px] items-center gap-2 rounded-md px-2.5 text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-7\">\n                    <div class=\"flex h-[30px] w-[30px] items-center justify-center rounded-full bg-[#C49EC8] text-[11px] font-extrabold text-[#291D2B]\" data-kid=\"1-1-2-2-7-1\">\n                        HL\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-7-2\">\n                        Hà Linh\n                    </span>\n                </div>\n                <div class=\"mb-1 mt-5 flex items-center justify-between px-2.5 text-[10px] font-extrabold uppercase tracking-[.09em] text-[#92949C]\" data-kid=\"1-1-2-2-8\">\n                    <span data-kid=\"1-1-2-2-8-1\">\n                        Nhóm gần đây\n                    </span>\n                    <i class=\"ph ph-plus text-[14px]\" data-kid=\"1-1-2-2-8-2\">\n                    </i>\n                </div>\n                <div class=\"flex h-[42px] items-center gap-2 rounded-md px-2.5 text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-9\">\n                    <div class=\"flex h-[30px] w-[30px] items-center justify-center rounded-full bg-[#5865F2] text-[10px] font-extrabold text-white\" data-kid=\"1-1-2-2-9-1\">\n                        3\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-9-2\">\n                        Đồ án đa luồng\n                    </span>\n                    <span class=\"ml-auto h-2 w-2 rounded-full bg-[#ED4245]\" data-kid=\"1-1-2-2-9-3\">\n                    </span>\n                </div>\n                <div class=\"flex h-[42px] items-center gap-2 rounded-md px-2.5 text-[13px] font-semibold text-[#B9BAC2]\" data-kid=\"1-1-2-2-10\">\n                    <div class=\"flex h-[30px] w-[30px] items-center justify-center rounded-full bg-[#8873B9] text-[10px] font-extrabold text-white\" data-kid=\"1-1-2-2-10-1\">\n                        2\n                    </div>\n                    <span class=\"truncate\" data-kid=\"1-1-2-2-10-2\">\n                        Cuối tuần nhé\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-auto\" data-kid=\"1-1-2-3\">\n                <div class=\"mx-2 mb-2 rounded-md bg-[#17181B] px-2.5 py-2.5\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"flex items-center gap-2 text-[11px] font-bold text-[#C5C6CD]\" data-kid=\"1-1-2-3-1-1\">\n                        <i class=\"ph ph-headset text-[16px] text-[#858790]\" data-kid=\"1-1-2-3-1-1-1\">\n                        </i>\n                        <span data-kid=\"1-1-2-3-1-1-2\">\n                            Chưa kết nối kênh gặp\n                        </span>\n                    </div>\n                    <div class=\"mt-1 pl-6 text-[10px] text-[#777A82]\" data-kid=\"1-1-2-3-1-2\">\n                        Khi tham gia, trạng thái sẽ hiện ở đây\n                    </div>\n                </div>\n                <div class=\"flex h-[58px] items-center gap-2 bg-[#191A1E] px-2.5\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"relative flex h-[32px] w-[32px] items-center justify-center rounded-full bg-[#91A5D1] text-[11px] font-extrabold text-[#202338]\" data-kid=\"1-1-2-3-2-1\">\n                        MN\n                        <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-2 border-[#191A1E] bg-[#43C07A]\" data-kid=\"1-1-2-3-2-1-1\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-2\">\n                        <div class=\"truncate text-[12px] font-bold text-white\" data-kid=\"1-1-2-3-2-2-1\">\n                            Minh Nguyễn\n                        </div>\n                        <div class=\"text-[10px] text-[#92949C]\" data-kid=\"1-1-2-3-2-2-2\">\n                            Đang hoạt động\n                        </div>\n                    </div>\n                    <button aria-label=\"Tắt tiếng\" class=\"flex h-7 w-7 items-center justify-center rounded text-[#B6B7BE]\" data-kid=\"1-1-2-3-2-3\">\n                        <i class=\"ph ph-microphone text-[16px]\" data-kid=\"1-1-2-3-2-3-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Cài đặt\" class=\"flex h-7 w-7 items-center justify-center rounded text-[#B6B7BE]\" data-kid=\"1-1-2-3-2-4\">\n                        <i class=\"ph ph-gear-six text-[16px]\" data-kid=\"1-1-2-3-2-4-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </aside>\n        <main class=\"flex min-w-0 flex-1 flex-col bg-[#27292D]\" data-kid=\"1-1-3\">\n            <header class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-[#202125] px-5\" data-kid=\"1-1-3-1\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-3-1-1\">\n                    <div class=\"relative flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-[#D28B82] text-[12px] font-extrabold text-[#281B1A]\" data-kid=\"1-1-3-1-1-1\">\n                        MP\n                        <span class=\"absolute bottom-0 right-0 h-[10px] w-[10px] rounded-full border-2 border-[#27292D] bg-[#43C07A]\" data-kid=\"1-1-3-1-1-1-1\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-3-1-1-2\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-1-2-1\">\n                            <span class=\"truncate text-[15px] font-extrabold text-white\" data-kid=\"1-1-3-1-1-2-1-1\">\n                                Mai Phương\n                            </span>\n                            <i class=\"ph ph-caret-down text-[13px] text-[#90929A]\" data-kid=\"1-1-3-1-1-2-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"text-[11px] text-[#A6A8AF]\" data-kid=\"1-1-3-1-1-2-2\">\n                            Đang hoạt động\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 text-[#B5B6BD]\" data-kid=\"1-1-3-1-2\">\n                    <button aria-label=\"Gọi thoại\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#35373D]\" data-kid=\"1-1-3-1-2-1\">\n                        <i class=\"ph ph-phone text-[19px]\" data-kid=\"1-1-3-1-2-1-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Gọi video\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#35373D]\" data-kid=\"1-1-3-1-2-2\">\n                        <i class=\"ph ph-video-camera text-[19px]\" data-kid=\"1-1-3-1-2-2-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Thêm bạn vào nhóm\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#35373D]\" data-kid=\"1-1-3-1-2-3\">\n                        <i class=\"ph ph-user-plus text-[19px]\" data-kid=\"1-1-3-1-2-3-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Tìm trong cuộc trò chuyện\" class=\"ml-1 flex h-8 w-[152px] items-center gap-2 rounded-md bg-[#1E1F23] px-2.5 text-[12px] text-[#8F9199]\" data-kid=\"1-1-3-1-2-4\">\n                        <span data-kid=\"1-1-3-1-2-4-1\">\n                            Tìm kiếm\n                        </span>\n                        <i class=\"ph ph-magnifying-glass ml-auto text-[16px]\" data-kid=\"1-1-3-1-2-4-2\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mở danh sách thành viên\" class=\"flex h-8 w-8 items-center justify-center rounded-md bg-[#3B3D44] text-[#F1F2F5]\" data-kid=\"1-1-3-1-2-5\">\n                        <i class=\"ph ph-users text-[18px]\" data-kid=\"1-1-3-1-2-5-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Tùy chọn cuộc trò chuyện\" class=\"flex h-8 w-8 items-center justify-center rounded-md hover:bg-[#35373D]\" data-kid=\"1-1-3-1-2-6\">\n                        <i class=\"ph ph-dots-three-vertical text-[18px]\" data-kid=\"1-1-3-1-2-6-1\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <div class=\"flex h-[38px] shrink-0 items-center gap-2 border-b border-[#202125] bg-[#24262A] px-5 text-[11px] text-[#B5B6BD]\" data-kid=\"1-1-3-2\">\n                <i class=\"ph ph-info text-[15px] text-[#A9ABB2]\" data-kid=\"1-1-3-2-1\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\">\n                    <span class=\"font-bold text-[#D4D5DA]\" data-kid=\"1-1-3-2-2-1\">\n                        Bản xem trước:\n                    </span>\n                    quyền sửa, xóa và thu hồi tin nhắn cần được xác nhận với backend.\n                </span>\n            </div>\n            <div class=\"relative flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-3-3\">\n                <section class=\"min-h-0 flex-1 overflow-hidden px-6 pt-5\" data-kid=\"1-1-3-3-1\">\n                    <div class=\"mx-auto flex h-full max-w-[780px] flex-col\" data-kid=\"1-1-3-3-1-1\">\n                        <div class=\"mb-4 flex items-center gap-2 border-b border-[#35373D] pb-3 text-[12px] text-[#AEB0B7]\" data-kid=\"1-1-3-3-1-1-1\">\n                            <i class=\"ph ph-chat-circle-dots text-[16px]\" data-kid=\"1-1-3-3-1-1-1-1\">\n                            </i>\n                            <span data-kid=\"1-1-3-3-1-1-1-2\">\n                                Cuộc trò chuyện với\n                                <span class=\"font-bold text-[#EAEBEE]\" data-kid=\"1-1-3-3-1-1-1-2-1\">\n                                    Mai Phương\n                                </span>\n                            </span>\n                            <span class=\"ml-auto text-[10px] text-[#858790]\" data-kid=\"1-1-3-3-1-1-1-3\">\n                                Hôm nay\n                            </span>\n                        </div>\n                        <div class=\"flex flex-col gap-4\" data-kid=\"1-1-3-3-1-1-2\">\n                            <div class=\"flex gap-3\" data-kid=\"1-1-3-3-1-1-2-1\">\n                                <div class=\"flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-[#D28B82] text